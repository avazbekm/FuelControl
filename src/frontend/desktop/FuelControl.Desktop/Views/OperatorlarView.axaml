<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:FuelControl.Desktop.Controls"
             xmlns:vm="using:FuelControl.Desktop.ViewModels"
             xmlns:m="using:FuelControl.Desktop.Models"
             xmlns:ctl="using:FuelControl.Desktop.Controls"
             x:Class="FuelControl.Desktop.Views.OperatorlarView"
             x:DataType="vm:OperatorlarViewModel">

    <Panel>
        <Grid RowDefinitions="Auto,*" Margin="28,22,28,24" RowSpacing="18">
            <StackPanel Grid.Row="0" Spacing="6">
                <TextBlock Text="{l:T OperatorlarHisobi}" Classes="sarlavha" FontSize="28" />
                <TextBlock Text="{l:T Operator_Izoh}" Classes="izoh" FontSize="13" />
            </StackPanel>

            <Grid Grid.Row="1" ColumnDefinitions="320,*" ColumnSpacing="18">
                <ScrollViewer Grid.Column="0" Padding="0,0,0,24">
                    <ItemsControl ItemsSource="{Binding Kartalar}" ClipToBounds="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:OperatorKartasi">
                                <Button Classes="karta" Margin="0,0,0,14"
                                        Command="{Binding $parent[UserControl].((vm:OperatorlarViewModel)DataContext).OperatorniTanlaCommand}" CommandParameter="{Binding}">
                                    <Border Classes="card" Padding="16,16" Classes.tanlangan="{Binding Tanlangan}">
                                        <Border.Styles>
                                            <Style Selector="Border.tanlangan"><Setter Property="BorderBrush" Value="#2F6BFF" /><Setter Property="BorderThickness" Value="2" /></Style>
                                        </Border.Styles>
                                        <StackPanel Spacing="12">
                                            <Grid ColumnDefinitions="44,*,Auto">
                                                <Border Classes="avatar" Width="44" Height="44"><TextBlock Text="{Binding Operator.BoshHarflar}" /></Border>
                                                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Spacing="2">
                                                    <TextBlock Text="{Binding Operator.ToliqIsm}" FontWeight="Bold" FontSize="14.5" />
                                                    <TextBlock Text="{Binding MaoshMatni}" Classes="izoh" />
                                                </StackPanel>
                                                <Border Grid.Column="2" Classes="badge yashil" IsVisible="{Binding SmenadaMi}" VerticalAlignment="Center"><TextBlock Text="{l:T Operator_Smenada}" /></Border>
                                            </Grid>
                                            <Border Classes="chiziq" />
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Text="{l:T JoriyQoldiq}" Classes="izoh" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{Binding QoldiqMatni}" FontSize="19" FontWeight="ExtraBold"
                                                           Classes.manfiy="{Binding QoldiqManfiy}" Classes.musbat="{Binding !QoldiqManfiy}" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding TanlanganBormi}">
                    <StackPanel Spacing="14" Margin="0,0,0,24">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2">
                                <TextBlock Text="{Binding Tanlangan.Operator.ToliqIsm}" FontSize="19" FontWeight="ExtraBold" />
                                <TextBlock Text="{Binding Tanlangan.OyKorsatkichlari}" Classes="izoh" FontSize="13" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                                <Button Command="{Binding VaraqaniOchCommand}"><StackPanel Orientation="Horizontal" Spacing="8"><ctl:Ikon Nomi="file" Olcham="15" /><TextBlock Text="{l:T HisobVaraqa}" /></StackPanel></Button>
                                <Button Classes="primary" Command="{Binding AvansniOchCommand}" IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext).KoradiAvans}"><StackPanel Orientation="Horizontal" Spacing="8"><ctl:Ikon Nomi="plus" Olcham="15" /><TextBlock Text="{l:T Operator_AvansTolov}" /></StackPanel></Button>
                            </StackPanel>
                        </Grid>

                        <UniformGrid Columns="4" ColumnSpacing="14" RowSpacing="14">
                            <Border Classes="kpi"><StackPanel Spacing="4"><TextBlock Text="{l:T Smenalar, Katta=True}" Classes="nom" /><TextBlock Text="{Binding Tanlangan.SmenalarSoni}" FontSize="21" FontWeight="ExtraBold" /><TextBlock Text="{Binding Tanlangan.SmenalarIzoh}" Classes="izoh" /></StackPanel></Border>
                            <Border Classes="kpi"><StackPanel Spacing="4"><TextBlock Text="{l:T Savdo, Katta=True}" Classes="nom" /><TextBlock Text="{Binding Tanlangan.OySavdo}" FontSize="21" FontWeight="ExtraBold" /><TextBlock Text="{l:T Operator_YopilganSmenalarda}" Classes="izoh" /></StackPanel></Border>
                            <Border Classes="kpi"><StackPanel Spacing="4"><TextBlock Text="{l:T Avans, Katta=True}" Classes="nom" /><TextBlock Text="{Binding Tanlangan.OyAvans}" FontSize="21" FontWeight="ExtraBold" Foreground="{DynamicResource Sariq}" /><TextBlock Text="{Binding Tanlangan.AvansIzoh}" Classes="izoh" /></StackPanel></Border>
                            <Border Classes="kpi"><StackPanel Spacing="4"><TextBlock Text="{l:T Kamomat, Katta=True}" Classes="nom" /><TextBlock Text="{Binding Tanlangan.OyKamomat}" FontSize="21" FontWeight="ExtraBold" Foreground="{DynamicResource Qizil}" /><TextBlock Text="{Binding Tanlangan.KamomatIzoh}" Classes="izoh" /></StackPanel></Border>
                            <Border Classes="kpi"><StackPanel Spacing="4"><TextBlock Text="{l:T Ortiqcha, Katta=True}" Classes="nom" /><TextBlock Text="{Binding Tanlangan.OyOrtiqcha}" FontSize="21" FontWeight="ExtraBold" Foreground="{DynamicResource Yashil}" /><TextBlock Text="{l:T Operator_ShuOy}" Classes="izoh" /></StackPanel></Border>
                        </UniformGrid>

                        <Border Classes="card" Padding="20,18">
                            <StackPanel Spacing="6">
                                <TextBlock Text="{l:T Operator_HisobHarakatlari}" Classes="kichikSarlavha" Margin="0,0,0,8" />
                                <Grid ColumnDefinitions="110,120,*,150,130" ColumnSpacing="10" Margin="6,0">
                                    <TextBlock Text="{l:T Sana, Katta=True}" Classes="jadvalSarlavha" />
                                    <TextBlock Grid.Column="1" Text="{l:T Turi, Katta=True}" Classes="jadvalSarlavha" />
                                    <TextBlock Grid.Column="2" Text="{l:T Izoh, Katta=True}" Classes="jadvalSarlavha" />
                                    <TextBlock Grid.Column="3" Text="{l:T KimYozdi, Katta=True}" Classes="jadvalSarlavha" />
                                    <TextBlock Grid.Column="4" Text="{l:T Summa, Katta=True}" Classes="jadvalSarlavha" HorizontalAlignment="Right" />
                                </Grid>
                                <ItemsControl ItemsSource="{Binding Harakatlar}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:HarakatQatori">
                                            <Border BorderBrush="{DynamicResource Chiziq}" BorderThickness="0,1,0,0" Padding="6,11">
                                                <Grid ColumnDefinitions="110,120,*,150,130" ColumnSpacing="10">
                                                    <TextBlock Text="{Binding Sana}" FontSize="13.5" VerticalAlignment="Center" />
                                                    <Border Grid.Column="1" Classes="badge" ctl:Klass.Nomi="{Binding BelgiKlassi}"><TextBlock Text="{Binding H.TuriNomi}" /></Border>
                                                    <TextBlock Grid.Column="2" Text="{Binding H.Izoh}" FontSize="13.5" TextWrapping="Wrap" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="3" Text="{Binding H.KimYozdi}" FontSize="13.5" Foreground="{DynamicResource MatnYumshoq}" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="4" Text="{Binding Summa}" FontSize="14" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                               Classes.musbat="{Binding Musbat}" Classes.manfiy="{Binding Manfiy}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- ============ Avans / to'lov dialogi ============ -->
        <Border Classes="parda" IsVisible="{Binding AvansOchiq}">
            <Border Classes="dialog" Width="460">
                <StackPanel Spacing="16">
                    <StackPanel Spacing="3">
                        <TextBlock Text="{l:T PulBerish}" Classes="sarlavha" />
                        <TextBlock Text="{Binding Tanlangan.Operator.ToliqIsm}" Classes="izoh" />
                    </StackPanel>
                    <UniformGrid Columns="2" ColumnSpacing="10">
                        <Button Classes="tolov" Classes.tanlangan="{Binding AvansTanlangan}" Content="{l:T Avans}" Command="{Binding AvansTuriniTanlaCommand}" CommandParameter="0" />
                        <Button Classes="tolov" Classes.tanlangan="{Binding TolovTanlangan}" Content="{l:T MaoshTolovi}" Command="{Binding AvansTuriniTanlaCommand}" CommandParameter="1" />
                    </UniformGrid>
                    <StackPanel>
                        <TextBlock Text="{l:T SummaSom, Katta=True}" Classes="yorliq" />
                        <TextBox Text="{Binding AvansSumma}" Classes="katta" PlaceholderText="0" ctl:AvtoFokus.Yoqilgan="True" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="{l:T Izoh, Katta=True}" Classes="yorliq" />
                        <TextBox Text="{Binding AvansIzoh}" PlaceholderText="{l:T IzohMisol2}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                        <Button Classes="ghost" Content="{l:T BekorQilish}" Command="{Binding AvansniYopCommand}" />
                        <Button Classes="primary" Content="{l:T Saqlash}" Command="{Binding AvansniSaqlaCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- ============ Hisob-varaqa dialogi ============ -->
        <Border Classes="parda" IsVisible="{Binding VaraqaOchiq}">
            <Border Classes="dialog" Width="760" MaxHeight="720">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,14">
                        <StackPanel Spacing="3">
                            <TextBlock Text="{l:T HisobVaraqa}" Classes="sarlavha" FontSize="22" />
                            <TextBlock Text="{Binding Tanlangan.Operator.ToliqIsm}" Classes="izoh" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Button Classes="ikon" Command="{Binding OldingiOyCommand}" ToolTip.Tip="{l:T OldingiOy}"><ctl:Ikon Nomi="back" Olcham="16" /></Button>
                            <TextBlock Text="{Binding VaraqaDavr}" FontWeight="Bold" VerticalAlignment="Center" MinWidth="130" TextAlignment="Center" />
                            <Button Classes="ikon" Command="{Binding KeyingiOyCommand}" ToolTip.Tip="{l:T KeyingiOy}"><ctl:Ikon Nomi="arrow" Olcham="16" /></Button>
                        </StackPanel>
                    </Grid>

                    <UniformGrid DockPanel.Dock="Top" Columns="4" ColumnSpacing="10" Margin="0,0,0,14">
                        <Border Classes="tile"><StackPanel Spacing="3"><TextBlock Text="{l:T BoshlangichQoldiq, Katta=True}" Classes="yorliq" Margin="0" TextWrapping="Wrap" FontSize="10" /><TextBlock Text="{Binding VaraqaBoshlangich}" FontWeight="ExtraBold" FontSize="16" /></StackPanel></Border>
                        <Border Classes="tile"><StackPanel Spacing="3"><TextBlock Text="{l:T Jami_Kirim, Katta=True}" Classes="yorliq" Margin="0" TextWrapping="Wrap" FontSize="10" /><TextBlock Text="{Binding VaraqaKirim}" FontWeight="ExtraBold" FontSize="16" Foreground="{DynamicResource Yashil}" /></StackPanel></Border>
                        <Border Classes="tile"><StackPanel Spacing="3"><TextBlock Text="{l:T Jami_Chiqim, Katta=True}" Classes="yorliq" Margin="0" TextWrapping="Wrap" FontSize="10" /><TextBlock Text="{Binding VaraqaChiqim}" FontWeight="ExtraBold" FontSize="16" Foreground="{DynamicResource Qizil}" /></StackPanel></Border>
                        <Border Classes="tile"><StackPanel Spacing="3"><TextBlock Text="{l:T YakuniyQoldiq, Katta=True}" Classes="yorliq" Margin="0" TextWrapping="Wrap" FontSize="10" /><TextBlock Text="{Binding VaraqaYakuniy}" FontWeight="ExtraBold" FontSize="16" Classes.manfiy="{Binding VaraqaYakuniyManfiy}" Classes.musbat="{Binding !VaraqaYakuniyManfiy}" /></StackPanel></Border>
                    </UniformGrid>

                    <StackPanel DockPanel.Dock="Bottom" Spacing="10" Margin="0,14,0,0">
                        <TextBlock Text="{Binding VaraqaXabar}" Classes="izoh" TextWrapping="Wrap" IsVisible="{Binding VaraqaXabar, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                            <Button Classes="ghost" Content="{l:T Yopish}" Command="{Binding VaraqaniYopCommand}" />
                            <Button Classes="primary" Command="{Binding VaraqaniEksportCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="8"><ctl:Ikon Nomi="excel" Olcham="16" /><TextBlock Text="{l:T ExcelgaChiqarish}" /></StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>

                    <DataGrid ItemsSource="{Binding VaraqaQatorlari}" MinHeight="200">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{l:T Sana}" Binding="{Binding Sana}" Width="110" />
                            <DataGridTextColumn Header="{l:T Turi}" Binding="{Binding Turi}" Width="130" />
                            <DataGridTextColumn Header="{l:T Izoh}" Binding="{Binding Izoh}" Width="*" />
                            <DataGridTemplateColumn Header="{l:T Summa}" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="vm:VaraqaQatori">
                                        <TextBlock Text="{Binding Summa}" VerticalAlignment="Center" TextAlignment="Right" Classes.musbat="{Binding Musbat}" Classes.manfiy="{Binding !Musbat}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="{l:T Qoldiq}" Binding="{Binding Qoldiq}" Width="120" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Border>
    </Panel>
</UserControl>
