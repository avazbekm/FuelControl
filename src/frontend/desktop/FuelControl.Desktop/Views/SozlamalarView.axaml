<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:FuelControl.Desktop.Controls"
             xmlns:vm="using:FuelControl.Desktop.ViewModels"
             xmlns:m="using:FuelControl.Desktop.Models"
             xmlns:ctl="using:FuelControl.Desktop.Controls"
             x:Class="FuelControl.Desktop.Views.SozlamalarView"
             x:DataType="vm:SozlamalarViewModel">

    <Panel>
    <Grid RowDefinitions="Auto,Auto,*" Margin="28,24,28,28" RowSpacing="16">
        <StackPanel Grid.Row="0" Spacing="3">
            <TextBlock Text="{l:T Sozlamalar}" Classes="sarlavha" />
            <TextBlock Text="{l:T SozlamalarIzoh}" Classes="izoh" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <Button Classes="chip" Classes.tanlangan="{Binding NarxlarBolimi}" Content="{l:T YoqilgiNarxlari}" Command="{Binding BolimniTanlaCommand}" CommandParameter="0" />
            <Button Classes="chip" Classes.tanlangan="{Binding AparatlarBolimi}" Content="{l:T Aparatlar}" Command="{Binding BolimniTanlaCommand}" CommandParameter="1" />
            <Button Classes="chip" Classes.tanlangan="{Binding FoydalanuvchilarBolimi}" Content="{l:T Foydalanuvchilar}" Command="{Binding BolimniTanlaCommand}" CommandParameter="2" />
            <Button Classes="chip" Classes.tanlangan="{Binding RuxsatlarBolimi}" Content="{l:T Ruxsatlar}" Command="{Binding BolimniTanlaCommand}" CommandParameter="3" />
            <Button Classes="chip" Classes.tanlangan="{Binding ZaxiraBolimi}" Content="{l:T ZaxiraNusxa}" Command="{Binding BolimniTanlaCommand}" CommandParameter="4" />
        </StackPanel>

        <Panel Grid.Row="2">
            <!-- Narxlar -->
            <Grid ColumnDefinitions="*,420" ColumnSpacing="18" IsVisible="{Binding NarxlarBolimi}">
                <Border Classes="card" VerticalAlignment="Top">
                    <StackPanel Spacing="14">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2">
                                <TextBlock Text="{l:T YoqilgiNarxlari}" Classes="kichikSarlavha" />
                                <TextBlock Text="{l:T Narx_Izoh}" Classes="izoh" TextWrapping="Wrap" MaxWidth="560" HorizontalAlignment="Left" />
                            </StackPanel>
                            <Button Grid.Column="1" Classes="primary" VerticalAlignment="Top" Command="{Binding YoqilgiQoshCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="8"><ctl:Ikon Nomi="plus" Olcham="16" /><TextBlock Text="{l:T YoqilgiQoshish}" /></StackPanel>
                            </Button>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Yoqilgilar}" ClipToBounds="False">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" ColumnSpacing="12" RowSpacing="12" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:YoqilgiQatoriVm">
                                    <Border Classes="ichki" Padding="16,14">
                                        <StackPanel Spacing="12">
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                                <Ellipse Width="12" Height="12" Fill="{Binding Rang}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{Binding Nomi}" FontWeight="ExtraBold" FontSize="16" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2" Text="{Binding AparatSoni}" Classes="izoh" VerticalAlignment="Center" />
                                            </Grid>
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="{l:T Narx_Hozirgi, Katta=True}" Classes="yorliq" Margin="0" />
                                                <StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="{Binding JoriyNarx}" FontSize="24" FontWeight="ExtraBold" /><TextBlock Text="{l:T Savdo_SomLitr}" FontSize="13" VerticalAlignment="Bottom" Margin="0,0,0,4" /></StackPanel>
                                            </StackPanel>
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                <Button Classes="primary" HorizontalAlignment="Stretch"
                                                        Command="{Binding $parent[UserControl].((vm:SozlamalarViewModel)DataContext).NarxniSaqlaCommand}" CommandParameter="{Binding}">
                                                    <StackPanel Orientation="Horizontal" Spacing="8"><ctl:Ikon Nomi="tag" Olcham="14" /><TextBlock Text="{l:T Narx_Ozgartirish}" /></StackPanel>
                                                </Button>
                                                <Button Grid.Column="1" ToolTip.Tip="{l:T Tahrirlash}"
                                                        Command="{Binding $parent[UserControl].((vm:SozlamalarViewModel)DataContext).YoqilginiTahrirlaCommand}" CommandParameter="{Binding}">
                                                    <ctl:Ikon Nomi="edit" Olcham="15" />
                                                </Button>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Classes="card" VerticalAlignment="Top">
                    <StackPanel Spacing="6">
                        <TextBlock Text="{l:T NarxTarixi}" Classes="kichikSarlavha" Margin="0,0,0,8" />
                        <TextBlock Text="{l:T MalumotYoq}" Classes="izoh" IsVisible="{Binding !NarxTarixi.Count}" />
                        <ItemsControl ItemsSource="{Binding NarxTarixi}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="m:NarxTarixi">
                                    <Border BorderBrush="{DynamicResource Chiziq}" BorderThickness="0,0,0,1" Padding="2,10">
                                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="2">
                                            <TextBlock FontWeight="Bold" FontSize="13.5"><Run Text="{Binding Yoqilgi}" /><Run Text=" · " /><Run Text="{Binding EskiNarx, StringFormat='#,0'}" /><Run Text=" → " /><Run Text="{Binding YangiNarx, StringFormat='#,0'}" /></TextBlock>
                                            <TextBlock Grid.Column="1" Text="{Binding Vaqt, StringFormat='dd.MM.yyyy HH:mm'}" Classes="izoh" />
                                            <TextBlock Grid.Row="1" Text="{Binding Kim}" Classes="izoh" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Aparatlar -->
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18" IsVisible="{Binding AparatlarBolimi}">
                <Border Classes="card" VerticalAlignment="Top">
                    <StackPanel Spacing="14">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2">
                                <TextBlock Text="{l:T Aparatlar}" Classes="kichikSarlavha" />
                                <TextBlock Text="{l:T Sozlama_AparatIzoh}" Classes="izoh" />
                            </StackPanel>
                            <Button Grid.Column="1" Classes="primary" Command="{Binding AparatQoshCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="8"><ctl:Ikon Nomi="plus" Olcham="16" /><TextBlock Text="{l:T AparatQoshish}" /></StackPanel>
                            </Button>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding AparatKartalari}" ClipToBounds="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Columns="2" ColumnSpacing="12" RowSpacing="12" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:AparatKartasi">
                                    <Button Classes="karta" Command="{Binding $parent[UserControl].((vm:SozlamalarViewModel)DataContext).AparatniTahrirlaCommand}" CommandParameter="{Binding A}">
                                        <Border Classes="ichki" Padding="16,14">
                                            <StackPanel Spacing="10">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock Text="{Binding Nomi}" FontSize="16" FontWeight="ExtraBold" />
                                                    <Border Grid.Column="1" Classes="yoqilgi" Background="{Binding Yoqilgi.Fon}">
                                                        <TextBlock Text="{Binding Yoqilgi.Nomi}" Foreground="{Binding Yoqilgi.Matn}" />
                                                    </Border>
                                                </Grid>
                                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="6">
                                                    <TextBlock Classes="qator" Text="{l:T Aparat_PultKorsatkichi}" />
                                                    <TextBlock Grid.Column="1" FontWeight="ExtraBold" FontSize="13.5"><Run Text="{Binding Pult}" /><Run Text=" L" /></TextBlock>
                                                    <TextBlock Grid.Row="1" Classes="qator" Text="{l:T Aparat_BakQoldigi}" />
                                                    <TextBlock Grid.Row="1" Grid.Column="1" FontWeight="ExtraBold" FontSize="13.5" Foreground="{DynamicResource Yashil}"
                                                               Classes.manfiy="{Binding BakManfiy}"><Run Text="{Binding Bak}" /><Run Text=" L" /></TextBlock>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Aparat yaratish / tahrirlash paneli -->
                <Border Grid.Column="1" Classes="card" Width="360" VerticalAlignment="Top" IsVisible="{Binding AparatDialogOchiq}">
                    <StackPanel Spacing="14">
                        <StackPanel Spacing="2">
                            <TextBlock Text="{Binding AparatDialogSarlavha}" FontSize="19" FontWeight="ExtraBold" />
                            <TextBlock Text="{Binding AparatDialogIzoh}" Classes="izoh" TextWrapping="Wrap" />
                        </StackPanel>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <StackPanel>
                                <TextBlock Text="{l:T Raqam, Katta=True}" Classes="yorliq" />
                                <TextBox Text="{Binding AparatRaqam}" MinHeight="46" CornerRadius="23" FontWeight="Bold" ctl:AvtoFokus.Yoqilgan="True" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{l:T Yoqilgi, Katta=True}" Classes="yorliq" />
                                <ComboBox ItemsSource="{Binding YoqilgiTurlari}" SelectedItem="{Binding AparatYoqilgi}" HorizontalAlignment="Stretch" MinHeight="46" CornerRadius="23" FontWeight="Bold">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="m:YoqilgiTuri">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Border Width="10" Height="10" CornerRadius="5" Background="{Binding Rang}" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Nomi}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                        <StackPanel Spacing="6">
                            <TextBlock Text="{Binding AparatPultYorliq}" Classes="yorliq" Margin="0" />
                            <TextBox Classes="orta" Text="{Binding AparatTotalLitr}" PlaceholderText="0.00" />
                            <TextBlock Text="{l:T Aparat_PultIzoh}" Classes="izoh" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Spacing="6">
                            <TextBlock Text="{Binding AparatBakYorliq}" Classes="yorliq" Margin="0" />
                            <TextBox Classes="orta" Text="{Binding AparatBak}" PlaceholderText="0" />
                            <TextBlock Text="{l:T Aparat_BakIzoh}" Classes="izoh" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel IsVisible="{Binding AparatTahrirda}">
                            <TextBlock Text="{l:T Aparat_TuzatishSababi, Katta=True}" Classes="yorliq" />
                            <TextBox Text="{Binding AparatSabab}" PlaceholderText="{l:T Aparat_SababPlaceholder}" MinHeight="46" CornerRadius="23" />
                        </StackPanel>
                        <TextBlock Text="{Binding AparatXato}" Classes="xatoMatn" IsVisible="{Binding AparatXato, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                            <Button Content="{l:T BekorQilish}" Command="{Binding AparatDialogniYopCommand}" />
                            <Button Classes="primary" MinWidth="110" Content="{l:T Saqlash}" Command="{Binding AparatniSaqlaCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Foydalanuvchilar -->
            <Border Classes="card" VerticalAlignment="Top" IsVisible="{Binding FoydalanuvchilarBolimi}">
                <StackPanel Spacing="14">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{l:T Foydalanuvchilar}" Classes="kichikSarlavha" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Classes="primary" Command="{Binding FoydalanuvchiQoshCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8"><ctl:Ikon Nomi="plus" Olcham="16" /><TextBlock Text="{l:T FoydalanuvchiQoshish}" /></StackPanel>
                        </Button>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Foydalanuvchilar}" ClipToBounds="False">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3" ColumnSpacing="12" RowSpacing="12" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="m:Foydalanuvchi">
                                <Border Classes="ichki" Padding="16,14">
                                    <StackPanel Spacing="12">
                                        <Grid ColumnDefinitions="44,*,Auto" ColumnSpacing="12">
                                            <Border Classes="avatar" Width="44" Height="44"><TextBlock Text="{Binding BoshHarflar}" /></Border>
                                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ToliqIsm}" FontWeight="Bold" FontSize="14.5" TextTrimming="CharacterEllipsis" />
                                                <StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Classes="izoh" Text="{l:T Login, Keyin=:}" /><TextBlock Classes="izoh" Text="{Binding Login}" /></StackPanel>
                                            </StackPanel>
                                            <Panel Grid.Column="2" VerticalAlignment="Top">
                                                <Border Classes="badge yashil" IsVisible="{Binding Faol}"><TextBlock Text="{l:T Faol}" /></Border>
                                                <Border Classes="badge kulrang" IsVisible="{Binding !Faol}"><TextBlock Text="{l:T Nofaol}" /></Border>
                                            </Panel>
                                        </Grid>
                                        <Border Classes="chiziq" />
                                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="6">
                                            <TextBlock Classes="qator" Text="{l:T Rol}" />
                                            <Border Grid.Column="1" Classes="badge kok" Padding="9,2"><TextBlock Text="{Binding RolNomi}" /></Border>
                                            <TextBlock Grid.Row="1" Classes="qator" Text="{l:T OylikMaosh}" />
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding OylikMaosh, StringFormat='#,0'}" FontWeight="ExtraBold" FontSize="13.5" />
                                            <TextBlock Grid.Row="2" Classes="qator" Text="{l:T Ruxsatlar}" />
                                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding RuxsatSoni}" FontWeight="ExtraBold" FontSize="13.5" />
                                        </Grid>
                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                            <Button HorizontalAlignment="Stretch" Padding="10,9" FontSize="13"
                                                    Command="{Binding $parent[UserControl].((vm:SozlamalarViewModel)DataContext).FoydalanuvchiniTahrirlaCommand}" CommandParameter="{Binding}">
                                                <StackPanel Orientation="Horizontal" Spacing="6"><ctl:Ikon Nomi="edit" Olcham="13" /><TextBlock Text="{l:T Tahrirlash}" /></StackPanel>
                                            </Button>
                                            <Button Grid.Column="1" HorizontalAlignment="Stretch" Padding="10,9" FontSize="13"
                                                    Command="{Binding $parent[UserControl].((vm:SozlamalarViewModel)DataContext).TiklashniOchCommand}" CommandParameter="{Binding}">
                                                <StackPanel Orientation="Horizontal" Spacing="6"><ctl:Ikon Nomi="lock" Olcham="13" /><TextBlock Text="{l:T PinYokiParol}" /></StackPanel>
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Ruxsatlar -->
            <Grid ColumnDefinitions="320,*" ColumnSpacing="16" IsVisible="{Binding RuxsatlarBolimi}">
                <Border Classes="card" Padding="12">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="{l:T Foydalanuvchilar}" Classes="kichikSarlavha" Margin="8,6,0,10" />
                        <ItemsControl ItemsSource="{Binding Foydalanuvchilar}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="m:Foydalanuvchi">
                                    <Button Classes="karta" Margin="0,0,0,8"
                                            Command="{Binding $parent[UserControl].((vm:SozlamalarViewModel)DataContext).RuxsatFoydalanuvchisiniTanlaCommand}" CommandParameter="{Binding}">
                                        <Border Classes="tile" Padding="10">
                                            <Grid ColumnDefinitions="36,*,Auto">
                                                <Border Classes="avatar" Width="36" Height="36"><TextBlock Text="{Binding BoshHarflar}" FontSize="12" /></Border>
                                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" Spacing="1">
                                                    <TextBlock Text="{Binding ToliqIsm}" FontWeight="Bold" FontSize="13" />
                                                    <TextBlock Text="{Binding RolNomi}" Classes="izoh" />
                                                </StackPanel>
                                                <Border Grid.Column="2" Classes="badge kok"><TextBlock Text="{Binding RuxsatSoni}" /></Border>
                                            </Grid>
                                        </Border>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                </Border>
                <Border Grid.Column="1" Classes="card" VerticalAlignment="Top">
                    <StackPanel Spacing="14">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2">
                                <TextBlock Text="{Binding RuxsatFoydalanuvchi.ToliqIsm}" FontSize="19" FontWeight="ExtraBold" />
                                <TextBlock Text="{Binding RuxsatIzohi}" Classes="izoh" />
                            </StackPanel>
                            <Button Grid.Column="1" Command="{Binding StandartRuxsatlarCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="8"><ctl:Ikon Nomi="refresh" Olcham="14" /><TextBlock Text="{l:T Sozlama_RolBoyichaTiklash}" /></StackPanel>
                            </Button>
                        </Grid>

                        <TextBlock Text="{l:T Sozlama_Bolimlar, Katta=True}" Classes="yorliq" Margin="0,4,0,0" />
                        <ItemsControl ItemsSource="{Binding BolimRuxsatlari}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3" ColumnSpacing="10" RowSpacing="10" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:RuxsatElementi">
                                    <Border Classes="ichki" Padding="12,10" CornerRadius="16">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <CheckBox IsChecked="{Binding Tanlangan}"><TextBlock Text="{Binding Nomi}" FontWeight="SemiBold" FontSize="13.5" /></CheckBox>
                                            <Border Grid.Column="1" Classes="badge kok" Padding="8,2" IsVisible="{Binding Yangi}"><TextBlock Text="{l:T Yangi}" FontSize="11" /></Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="{l:T Sozlama_Amallar, Katta=True}" Classes="yorliq" Margin="0,4,0,0" />
                        <ItemsControl ItemsSource="{Binding AmalRuxsatlari}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" ColumnSpacing="10" RowSpacing="10" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:RuxsatElementi">
                                    <Border Classes="ichki" Padding="12,10" CornerRadius="16">
                                        <CheckBox IsChecked="{Binding Tanlangan}" HorizontalAlignment="Stretch">
                                            <StackPanel Spacing="2">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{Binding Nomi}" FontWeight="SemiBold" FontSize="13.5" />
                                                    <Border Classes="badge kok" Padding="8,2" IsVisible="{Binding Yangi}"><TextBlock Text="{l:T Yangi}" FontSize="11" /></Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Izoh}" Classes="izoh" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </CheckBox>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Classes="ogoh" Padding="18,12">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <ctl:Ikon Nomi="info" Olcham="15" Rang="{DynamicResource OgohMatn}" VerticalAlignment="Top" Margin="0,1,0,0" />
                                <TextBlock Grid.Column="1" Text="{l:T Sozlama_RuxsatEslatma}" />
                            </Grid>
                        </Border>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <Border Classes="badge sariq" IsVisible="{Binding RuxsatSaqlanmagan}"><TextBlock Text="{l:T Sozlama_Saqlanmagan}" /></Border>
                            <Button Grid.Column="1" Classes="primary" Command="{Binding RuxsatlarniSaqlaCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="8"><ctl:Ikon Nomi="check" Olcham="15" /><TextBlock Text="{l:T Sozlama_RuxsatlarniSaqlash}" /></StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Zaxira -->
            <Border Classes="card" IsVisible="{Binding ZaxiraBolimi}" MaxWidth="700" HorizontalAlignment="Left" VerticalAlignment="Top">
                <StackPanel Spacing="14">
                    <TextBlock Text="{l:T ZaxiraNusxa}" Classes="kichikSarlavha" />
                    <Border Classes="tile">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2">
                                <TextBlock Text="{l:T AvtomatikNusxa}" FontWeight="SemiBold" />
                                <TextBlock Text="{l:T NusxaIzoh}" Classes="izoh" />
                            </StackPanel>                        </Grid>
                    </Border>
                    <Border Classes="tile">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2">
                                <TextBlock Text="{l:T OxirgiNusxa}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding OxirgiNusxa}" Classes="izoh" />
                            </StackPanel>
                            <Button Grid.Column="1" Classes="primary" Content="{l:T HozirNusxa}" Command="{Binding HozirNusxaCommand}" />
                        </Grid>
                    </Border>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Classes="ghost" Content="{l:T NusxadanTiklash}" Command="{Binding PapkaniOchCommand}" />
                        <Button Classes="ghost" Content="{l:T PapkaniOchish}" Command="{Binding PapkaniOchCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Panel>
    </Grid>

    <!-- ============ Yoqilg'i dialogi ============ -->
    <Border Classes="parda" IsVisible="{Binding YoqilgiDialogOchiq}">
        <Border Classes="dialog" Width="460">
            <StackPanel Spacing="14">
                <TextBlock Text="{Binding YoqilgiDialogSarlavha}" Classes="sarlavha" FontSize="22" />
                <StackPanel>
                    <TextBlock Text="{l:T Nomi, Katta=True}" Classes="yorliq" />
                    <TextBox Text="{Binding YNomi}" PlaceholderText="{l:T NomiMisol}" FontWeight="Bold" ctl:AvtoFokus.Yoqilgan="True" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="{l:T Narx, Katta=True}" Classes="yorliq" />
                    <TextBox Text="{Binding YNarx}" TextAlignment="Right" PlaceholderText="0" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="{l:T Rang, Katta=True}" Classes="yorliq" />
                    <ItemsControl ItemsSource="{Binding Ranglar}" ClipToBounds="False">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="8" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:RangElementi">
                                <Button Classes="karta" Width="36" Height="36" CornerRadius="18"
                                        Command="{Binding $parent[UserControl].((vm:SozlamalarViewModel)DataContext).YRangniTanlaCommand}" CommandParameter="{Binding Rang}">
                                    <Border Width="36" Height="36" CornerRadius="18" Background="{Binding Rang}" BorderThickness="3" BorderBrush="Transparent"
                                            Classes.tanlangan="{Binding Tanlangan}">
                                        <Border.Styles>
                                            <Style Selector="Border.tanlangan"><Setter Property="BorderBrush" Value="{DynamicResource Matn}" /></Style>
                                        </Border.Styles>
                                        <ctl:Ikon Nomi="check" Olcham="16" Rang="White" IsVisible="{Binding Tanlangan}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                <TextBlock Text="{Binding YXato}" Foreground="{DynamicResource Qizil}" FontSize="12" TextWrapping="Wrap" IsVisible="{Binding YXato, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
                    <Button Classes="danger" Content="{l:T Ochirish}" IsVisible="{Binding !YoqilgiYangi}" Command="{Binding YoqilginiOchirCommand}" />
                    <Button Grid.Column="2" Classes="ghost" Content="{l:T BekorQilish}" Command="{Binding YoqilgiDialogniYopCommand}" />
                    <Button Grid.Column="3" Classes="primary" Content="{l:T Saqlash}" Command="{Binding YoqilginiSaqlaCommand}" />
                </Grid>
            </StackPanel>
        </Border>
    </Border>

    <!-- ============ Foydalanuvchi dialogi ============ -->
    <Border Classes="parda" IsVisible="{Binding FDialogOchiq}">
        <Border Classes="dialog" Width="520">
            <StackPanel Spacing="14">
                <TextBlock Text="{Binding FDialogSarlavha}" Classes="sarlavha" FontSize="22" />
                <StackPanel>
                    <TextBlock Text="{l:T ToliqIsm, Katta=True}" Classes="yorliq" />
                    <TextBox Text="{Binding FIsm}" ctl:AvtoFokus.Yoqilgan="True" />
                </StackPanel>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <StackPanel>
                        <TextBlock Text="{l:T Login, Katta=True}" Classes="yorliq" />
                        <TextBox Text="{Binding FLogin}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{l:T Rol, Katta=True}" Classes="yorliq" />
                        <ComboBox ItemsSource="{Binding Rollar}" SelectedItem="{Binding FRol}" HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:RolElementi"><TextBlock Text="{Binding Nomi}" /></DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                </Grid>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <StackPanel>
                        <TextBlock Text="{l:T OylikMaosh, Katta=True}" Classes="yorliq" />
                        <TextBox Text="{Binding FMaosh}" TextAlignment="Right" PlaceholderText="0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{l:T PinYokiParol, Katta=True}" Classes="yorliq" />
                        <TextBox Text="{Binding FPinParol}" PasswordChar="●" />
                    </StackPanel>
                </Grid>
                <CheckBox IsChecked="{Binding FFaol}" Content="{l:T FaolHolat}" />
                <TextBlock Text="{Binding FXato}" Foreground="{DynamicResource Qizil}" FontSize="12" IsVisible="{Binding FXato, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                    <Button Classes="ghost" Content="{l:T BekorQilish}" Command="{Binding FDialogniYopCommand}" />
                    <Button Classes="primary" Content="{l:T Saqlash}" Command="{Binding FoydalanuvchiniSaqlaCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Border>

    <!-- ============ PIN/parol tiklash dialogi ============ -->
    <Border Classes="parda" IsVisible="{Binding TiklashOchiq}">
        <Border Classes="dialog" Width="420">
            <StackPanel Spacing="14">
                <TextBlock Text="{l:T PinParolTiklash}" Classes="sarlavha" FontSize="22" />
                <TextBlock Text="{Binding TiklashF.ToliqIsm}" Classes="izoh" />
                <StackPanel>
                    <TextBlock Text="{l:T YangiPinParol, Katta=True}" Classes="yorliq" />
                    <TextBox Text="{Binding YangiPin}" Classes="katta" TextAlignment="Center" ctl:AvtoFokus.Yoqilgan="True" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                    <Button Classes="ghost" Content="{l:T BekorQilish}" Command="{Binding TiklashniYopCommand}" />
                    <Button Classes="primary" Content="{l:T Tiklash}" Command="{Binding TiklashniSaqlaCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Border>
    </Panel>
</UserControl>
