<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:FuelControl.Desktop.Controls"
             xmlns:ctl="using:FuelControl.Desktop.Controls"
             xmlns:vm="using:FuelControl.Desktop.ViewModels"
             x:Class="FuelControl.Desktop.Views.AuditView"
             x:DataType="vm:AuditViewModel">

    <Grid RowDefinitions="Auto,*" Margin="28,22,28,24" RowSpacing="18">
        <StackPanel Spacing="6">
            <TextBlock Text="{l:T AuditJurnali}" Classes="sarlavha" FontSize="28" />
            <TextBlock Text="{l:T Audit_Izoh}" Classes="izoh" FontSize="13" />
        </StackPanel>

        <Border Grid.Row="1" Classes="card" Padding="20,18,20,8">
            <DockPanel>
                <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="0,0,0,8">
                    <TextBox Text="{Binding Qidiruv}" PlaceholderText="{l:T Audit_QidiruvPlaceholder}" MinHeight="44" CornerRadius="22">
                        <TextBox.InnerLeftContent>
                            <ctl:Ikon Nomi="search" Olcham="16" Margin="14,0,0,0" Rang="{DynamicResource MatnIkkilamchi}" />
                        </TextBox.InnerLeftContent>
                    </TextBox>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <Button Classes="chip" MinHeight="44" Classes.tanlangan="{Binding TurHammasi}" Content="{l:T Hammasi}" Command="{Binding TurniTanlaCommand}" CommandParameter="" />
                        <Button Classes="chip" MinHeight="44" Classes.tanlangan="{Binding TurSmena}" Content="{l:T Smena}" Command="{Binding TurniTanlaCommand}" CommandParameter="smena" />
                        <Button Classes="chip" MinHeight="44" Classes.tanlangan="{Binding TurNasiya}" Content="{l:T Audit_TurNasiya}" Command="{Binding TurniTanlaCommand}" CommandParameter="nasiya" />
                        <Button Classes="chip" MinHeight="44" Classes.tanlangan="{Binding TurXarajat}" Content="{l:T Audit_TurXarajat}" Command="{Binding TurniTanlaCommand}" CommandParameter="xarajat" />
                        <Button Classes="chip" MinHeight="44" Classes.tanlangan="{Binding TurBak}" Content="{l:T Audit_TurBak}" Command="{Binding TurniTanlaCommand}" CommandParameter="bak" />
                        <Button Classes="chip" MinHeight="44" Classes.tanlangan="{Binding TurTuzatish}" Content="{l:T Audit_TurTuzatish}" Command="{Binding TurniTanlaCommand}" CommandParameter="tuzatish" />
                    </StackPanel>
                </Grid>

                <TextBlock DockPanel.Dock="Top" Text="{l:T MalumotYoq}" Classes="izoh" Margin="4,16" IsVisible="{Binding BoshQator}" />

                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Yozuvlar}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:AuditQatori">
                                <Border BorderBrush="{DynamicResource Chiziq}" BorderThickness="0,0,0,1" Padding="4,12">
                                    <Grid ColumnDefinitions="106,206,184,*">
                                        <StackPanel VerticalAlignment="Center" Spacing="1">
                                            <TextBlock Text="{Binding Vaqt}" FontSize="13.5" FontWeight="Bold" />
                                            <TextBlock Text="{Binding Sana}" Classes="izoh" FontSize="12" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                            <Border Classes="avatar" Width="34" Height="34">
                                                <TextBlock Text="{Binding Harflar}" FontSize="12" />
                                            </Border>
                                            <TextBlock Text="{Binding Y.Kim}" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="160" />
                                        </StackPanel>
                                        <Border Grid.Column="2" Classes="badge" ctl:Klass.Nomi="{Binding BelgiKlassi}" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Y.Amal}" />
                                        </Border>
                                        <TextBlock Grid.Column="3" Text="{Binding Y.Tafsilot}" FontSize="13.5" Foreground="{DynamicResource MatnYumshoq}"
                                                   TextWrapping="Wrap" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
