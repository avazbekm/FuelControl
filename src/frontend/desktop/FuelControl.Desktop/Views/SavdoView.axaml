<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:FuelControl.Desktop.Controls"
             xmlns:ctl="using:FuelControl.Desktop.Controls"
             xmlns:vm="using:FuelControl.Desktop.ViewModels"
             x:Class="FuelControl.Desktop.Views.SavdoView"
             x:DataType="vm:SavdoViewModel">

    <UserControl.Styles>
        <!-- Ko'k (deep) panel ichidagi qatorlar -->
        <Style Selector="Border.deep TextBlock.deepYorliq">
            <Setter Property="Foreground" Value="#D9FFFFFF" />
            <Setter Property="FontSize" Value="13.5" />
        </Style>
        <Style Selector="Border.deep TextBlock.deepQiymat">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="FontWeight" Value="ExtraBold" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
        <Style Selector="TextBox.oq">
            <Setter Property="Background" Value="#FAFFFFFF" />
            <Setter Property="Foreground" Value="#0B1530" />
            <Setter Property="BorderBrush" Value="#E6FFFFFF" />
        </Style>
        <Style Selector="TextBox.oq:focus /template/ Border#PART_BorderElement, TextBox.oq:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="White" />
        </Style>
        <Style Selector="Button.ochirX">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="-4,0,-8,0" />
        </Style>
        <Style Selector="Button.ochirX:pointerover /template/ Border#PART_Bg">
            <Setter Property="Background" Value="{DynamicResource BadgeQizilFon}" />
        </Style>
        <Style Selector="TextBlock.katta">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="ExtraBold" />
        </Style>
    </UserControl.Styles>

    <Panel>
        <!-- ===================================================== 1. OCHIQ SMENA ===================================================== -->
        <ScrollViewer IsVisible="{Binding OchiqKorinsin}" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="28,22,28,28" Spacing="18">
                <!-- Sarlavha -->
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{l:T Savdo}" Classes="sarlavha" FontSize="28" />
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <Border Classes="badge yashil"><StackPanel Orientation="Horizontal" Spacing="7"><Ellipse Width="7" Height="7" Fill="{DynamicResource BadgeYashilMatn}" VerticalAlignment="Center" /><TextBlock Text="{l:T Savdo_SmenaOchiq}" /></StackPanel></Border>
                            <TextBlock Grid.Column="1" Text="{Binding SmenaIzoh}" Classes="izoh" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Bottom">
                        <Button IsVisible="{Binding BakKirimOladi}" Command="{Binding BakKirimCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8"><ctl:Ikon Nomi="truck" Olcham="17" /><TextBlock Text="{l:T Bak_Kirim}" /></StackPanel>
                        </Button>
                        <Button Classes="primary" IsVisible="{Binding YopaOladi}" Command="{Binding YopishniBoshlaCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8"><ctl:Ikon Nomi="stop" Olcham="15" /><TextBlock Text="{l:T Savdo_SmenaniYopish}" /></StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Qoldiqlar + joriy smena -->
                <Grid ColumnDefinitions="*,320" ColumnSpacing="18">
                    <Border Classes="card" Padding="20,18" VerticalAlignment="Top">
                        <StackPanel Spacing="16">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <TextBlock Text="{l:T Savdo_OchilgandagiQoldiqlar}" Classes="kichikSarlavha" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1" Text="{l:T Savdo_OperatorKiritgan}" Classes="izoh" />
                            </Grid>
                            <ctl:Moslashuvchan ElementEni="180" MaksUstun="3">
                                <Border Classes="ichki">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                                        <Border Classes="ikonDoira" Width="40" Height="40" Background="{DynamicResource BadgeKokFon}">
                                            <ctl:Ikon Nomi="cash" Olcham="18" Rang="{DynamicResource BadgeKokMatn}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="{l:T Savdo_QaytimNaqd, Katta=True}" Classes="yorliq" Margin="0" />
                                            <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Qaytim}" FontSize="20" FontWeight="ExtraBold" VerticalAlignment="Bottom" /><TextBlock Text=" " VerticalAlignment="Bottom" /><TextBlock Text="{l:T Som}" FontSize="13" VerticalAlignment="Bottom" /></StackPanel></Viewbox>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border Classes="ichki">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                                        <Border Classes="ikonDoira" Width="40" Height="40" Background="#2619B5C9">
                                            <ctl:Ikon Nomi="card" Olcham="18" Rang="#0E8A9A" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="{l:T Savdo_TerminalPlastik, Katta=True}" Classes="yorliq" Margin="0" />
                                            <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding OchishTerminal}" FontSize="20" FontWeight="ExtraBold" VerticalAlignment="Bottom" /><TextBlock Text=" " VerticalAlignment="Bottom" /><TextBlock Text="{l:T Som}" FontSize="13" VerticalAlignment="Bottom" /></StackPanel></Viewbox>
                                            <TextBlock Text="{l:T Savdo_TerminalIzoh}" Classes="izoh" FontSize="12" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border Classes="ichki">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                                        <Border Classes="ikonDoira" Width="40" Height="40" Background="{DynamicResource BadgeBinafshaFon}">
                                            <ctl:Ikon Nomi="wallet" Olcham="18" Rang="{DynamicResource BadgeBinafshaMatn}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="{l:T Savdo_DepozitKarta, Katta=True}" Classes="yorliq" Margin="0" />
                                            <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding OchishDepozit}" FontSize="20" FontWeight="ExtraBold" VerticalAlignment="Bottom" /><TextBlock Text=" " VerticalAlignment="Bottom" /><TextBlock Text="{l:T Som}" FontSize="13" VerticalAlignment="Bottom" /></StackPanel></Viewbox>
                                            <TextBlock Text="{l:T Savdo_DepozitIzoh}" Classes="izoh" FontSize="12" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </ctl:Moslashuvchan>
                            <Border Classes="chiziq" />
                            <ctl:Moslashuvchan ElementEni="200" MaksUstun="3">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                    <Border Width="28" Height="28" CornerRadius="14" Background="#1EA66A" VerticalAlignment="Top">
                                        <ctl:Ikon Nomi="check" Olcham="14" Rang="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="1">
                                        <TextBlock Text="{l:T Savdo_Bosqich1}" FontWeight="Bold" FontSize="13.5" />
                                        <TextBlock Text="{Binding Bosqich1Izoh}" Classes="izoh" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                    <Border Classes="qadam" VerticalAlignment="Top"><TextBlock Text="2" /></Border>
                                    <StackPanel Grid.Column="1" Spacing="1">
                                        <TextBlock Text="{l:T Savdo_Bosqich2}" FontWeight="Bold" FontSize="13.5" />
                                        <TextBlock Text="{l:T Savdo_Bosqich2Izoh}" Classes="izoh" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                    <Border Width="28" Height="28" CornerRadius="14" Background="{DynamicResource BadgeKulrangFon}" VerticalAlignment="Top">
                                        <TextBlock Text="3" FontWeight="ExtraBold" FontSize="13" Foreground="{DynamicResource BadgeKulrangMatn}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="1">
                                        <TextBlock Text="{l:T Savdo_Bosqich3}" FontWeight="Bold" FontSize="13.5" />
                                        <TextBlock Text="{l:T Savdo_Bosqich3Izoh}" Classes="izoh" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </ctl:Moslashuvchan>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Classes="deep" Padding="24,22">
                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,6">
                                <Border Width="30" Height="30" CornerRadius="15" Background="#40FFFFFF">
                                    <ctl:Ikon Nomi="clock" Olcham="16" Rang="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="{Binding JoriySmenaSarlavha}" Foreground="White" FontSize="17" FontWeight="ExtraBold" VerticalAlignment="Center" TextWrapping="Wrap" />
                            </StackPanel>
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12"><TextBlock Classes="deepYorliq" Text="{l:T Savdo_Operator}" /><TextBlock Grid.Column="1" Classes="deepQiymat" Text="{Binding OperatorIsmi}" TextTrimming="CharacterEllipsis" /></Grid>
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12"><TextBlock Classes="deepYorliq" Text="{l:T Savdo_Ochildi}" /><Viewbox Grid.Column="1" StretchDirection="DownOnly" HorizontalAlignment="Right"><TextBlock Classes="deepQiymat" Text="{Binding Ochildi}" /></Viewbox></Grid>
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12"><TextBlock Classes="deepYorliq" Text="{l:T Savdo_Davomiyligi}" /><Viewbox Grid.Column="1" StretchDirection="DownOnly" HorizontalAlignment="Right"><TextBlock Classes="deepQiymat" Text="{Binding Davomiylik}" /></Viewbox></Grid>
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12"><TextBlock Classes="deepYorliq" Text="{l:T Savdo_NasiyaBerildi}" /><Viewbox Grid.Column="1" StretchDirection="DownOnly" HorizontalAlignment="Right"><TextBlock Classes="deepQiymat" Text="{Binding NasiyaJami}" /></Viewbox></Grid>
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12"><TextBlock Classes="deepYorliq" Text="{l:T Savdo_QaytganNasiya}" /><Viewbox Grid.Column="1" StretchDirection="DownOnly" HorizontalAlignment="Right"><TextBlock Classes="deepQiymat" Text="{Binding QaytganJami}" /></Viewbox></Grid>
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12"><TextBlock Classes="deepYorliq" Text="{l:T Savdo_Xarajatlar}" /><Viewbox Grid.Column="1" StretchDirection="DownOnly" HorizontalAlignment="Right"><TextBlock Classes="deepQiymat" Text="{Binding XarajatJami}" /></Viewbox></Grid>
                            <Border Height="1" Background="#40FFFFFF" Margin="0,6" />
                            <TextBlock Text="{l:T Savdo_FarqIzoh}" Foreground="#E6FFFFFF" FontSize="13" TextWrapping="Wrap" />
                            <Button Classes="success" Height="52" FontSize="16" HorizontalAlignment="Stretch" Margin="0,8,0,0"
                                    IsVisible="{Binding YopaOladi}" Command="{Binding YopishniBoshlaCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="8"><ctl:Ikon Nomi="check" Olcham="17" Rang="White" /><TextBlock Text="{l:T Savdo_SmenaniYopish}" /></StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Aparatlar -->
                <Border Classes="card" Padding="20,18">
                    <StackPanel Spacing="14">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                            <TextBlock Text="{l:T Savdo_Aparatlar}" Classes="kichikSarlavha" />
                            <TextBlock Grid.Column="1" Text="{Binding AparatlarIzoh}" Classes="izoh" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Aparatlar}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><ctl:Moslashuvchan ElementEni="215" MaksUstun="6" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:AparatKartasi">
                                    <Border Classes="ichki" Padding="16,14">
                                        <StackPanel Spacing="8">
                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                                <TextBlock Text="{Binding Nomi}" FontSize="16" FontWeight="ExtraBold" VerticalAlignment="Center" />
                                                <Border Grid.Column="1" Classes="yoqilgi" Background="{Binding Yoqilgi.Fon}" HorizontalAlignment="Right">
                                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                                                        <Ellipse Width="7" Height="7" Fill="{Binding Yoqilgi.Nuqta}" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Yoqilgi.Nomi}" Foreground="{Binding Yoqilgi.Matn}" TextTrimming="CharacterEllipsis" />
                                                    </Grid>
                                                </Border>
                                            </Grid>
                                            <TextBlock Text="{Binding Narx}" Classes="izoh" FontSize="13" />
                                            <Border Classes="chiziq" />
                                            <TextBlock Text="{l:T Savdo_PultKorsatkichi, Katta=True}" Classes="yorliq" Margin="0,2,0,0" />
                                            <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Pult}" FontSize="20" FontWeight="ExtraBold" VerticalAlignment="Bottom" /><TextBlock Text=" L" FontSize="13" VerticalAlignment="Bottom" /></StackPanel></Viewbox>
                                            <Panel>
                                                <Border Classes="yashilTile" IsVisible="{Binding !BakManfiy}">
                                                    <StackPanel Spacing="2">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <ctl:Ikon Nomi="bak" Olcham="12" Rang="{DynamicResource YashilTileMatn}" />
                                                            <TextBlock Text="{l:T Savdo_BakQoldigi, Katta=True}" FontSize="10.5" FontWeight="Bold" LetterSpacing="1" Foreground="{DynamicResource YashilTileMatn}" TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                        <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Bak}" FontSize="17" FontWeight="ExtraBold" VerticalAlignment="Bottom" /><TextBlock Text=" L" FontSize="12" VerticalAlignment="Bottom" /></StackPanel></Viewbox>
                                                        <TextBlock Text="{Binding OxirgiKirim}" Classes="izoh" FontSize="12" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Border>
                                                <Border Classes="qizilTile" IsVisible="{Binding BakManfiy}">
                                                    <StackPanel Spacing="2">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <ctl:Ikon Nomi="alert" Olcham="12" Rang="{DynamicResource Qizil}" />
                                                            <TextBlock Text="{l:T Savdo_BakQoldigi, Katta=True}" FontSize="10.5" FontWeight="Bold" LetterSpacing="1" Foreground="{DynamicResource Qizil}" TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                        <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Bak}" FontSize="17" FontWeight="ExtraBold" Foreground="{DynamicResource Qizil}" VerticalAlignment="Bottom" /><TextBlock Text=" L" FontSize="12" Foreground="{DynamicResource Qizil}" VerticalAlignment="Bottom" /></StackPanel></Viewbox>
                                                        <TextBlock Text="{Binding OxirgiKirim}" Classes="izoh" FontSize="12" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Border>
                                            </Panel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Nasiya / xarajat / muddati o'tgan -->
                <ctl:Moslashuvchan ElementEni="330" MaksUstun="3" ColumnSpacing="18" RowSpacing="18">
                    <!-- Nasiya -->
                    <Border Classes="card" Padding="20,18" VerticalAlignment="Top">
                        <StackPanel Spacing="12">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <Border Classes="ikonDoira" Width="40" Height="40" Background="{DynamicResource BadgeOlovFon}">
                                    <ctl:Ikon Nomi="receipt" Olcham="18" Rang="{DynamicResource BadgeOlovMatn}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                    <TextBlock Text="{l:T Savdo_Nasiya}" Classes="kichikSarlavha" />
                                    <TextBlock Text="{Binding NasiyaIzoh}" Classes="izoh" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="{l:T Savdo_NasiyaYoq}" Classes="izoh" IsVisible="{Binding NasiyaYoq}" Margin="0,6" />
                            <ItemsControl ItemsSource="{Binding Nasiyalar}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:YozuvQatori">
                                        <Border BorderBrush="{DynamicResource Chiziq}" BorderThickness="0,0,0,1" Padding="0,10">
                                            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
                                                <Border Classes="avatar" Width="38" Height="38" VerticalAlignment="Center"><TextBlock Text="{Binding Harflar}" FontSize="12.5" /></Border>
                                                <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Sarlavha}" FontWeight="Bold" FontSize="14" TextTrimming="CharacterEllipsis" />
                                                    <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left"><TextBlock Text="{Binding Izoh}" Classes="izoh" /></Viewbox>
                                                    <Border Classes="davlatRaqam" HorizontalAlignment="Left" IsVisible="{Binding Raqam, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"><TextBlock Text="{Binding Raqam}" /></Border>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Spacing="6" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Summa}" FontSize="17" FontWeight="ExtraBold" HorizontalAlignment="Right" />
                                                    <Border Classes="badge" ctl:Klass.Nomi="{Binding BelgiKlassi}" HorizontalAlignment="Right"><TextBlock Text="{Binding Belgi}" /></Border>
                                                </StackPanel>
                                                <Button Grid.Column="3" Classes="ikon ochirX" VerticalAlignment="Center" IsVisible="{Binding OchirishMumkin}" ToolTip.Tip="{l:T Ochirish}"
                                                        Command="{Binding $parent[UserControl].((vm:SavdoViewModel)DataContext).OchirCommand}" CommandParameter="{Binding}">
                                                    <ctl:Ikon Nomi="x" Olcham="13" />
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ItemsControl ItemsSource="{Binding Qaytishlar}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:YozuvQatori">
                                        <Border Classes="yashilTile" Margin="0,4,0,0">
                                            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
                                                <ctl:Ikon Nomi="undo" Olcham="15" Rang="{DynamicResource YashilTileMatn}" VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center"><TextBlock Text="{Binding Sarlavha}" FontWeight="Bold" FontSize="12.5" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Izoh}" FontSize="12.5" TextWrapping="Wrap" /></StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding Summa}" FontSize="16" FontWeight="ExtraBold" Foreground="{DynamicResource Yashil}" VerticalAlignment="Center" />
                                                <Button Grid.Column="3" Classes="ikon ochirX" VerticalAlignment="Center" IsVisible="{Binding OchirishMumkin}" ToolTip.Tip="{l:T Ochirish}"
                                                        Command="{Binding $parent[UserControl].((vm:SavdoViewModel)DataContext).OchirCommand}" CommandParameter="{Binding}">
                                                    <ctl:Ikon Nomi="x" Olcham="12" />
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <WrapPanel ItemSpacing="10" LineSpacing="10" Margin="0,4,0,0">
                                <Button Classes="primary" IsVisible="{Binding NasiyaYozaOladi}" Command="{Binding NasiyaYozCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="8"><ctl:Ikon Nomi="plus" Olcham="15" /><TextBlock Text="{l:T Nasiya_Yozish}" /></StackPanel>
                                </Button>
                                <Button IsVisible="{Binding QarzQaytdiOladi}" Command="{Binding QarzQaytdiCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="8"><ctl:Ikon Nomi="undo" Olcham="15" /><TextBlock Text="{l:T Nasiya_QarzQaytdi}" /></StackPanel>
                                </Button>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- Xarajatlar -->
                    <Border Classes="card" Padding="20,18" VerticalAlignment="Top">
                        <StackPanel Spacing="12">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <Border Classes="ikonDoira" Width="40" Height="40" Background="{DynamicResource BadgeSariqFon}">
                                    <ctl:Ikon Nomi="file" Olcham="18" Rang="{DynamicResource BadgeSariqMatn}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                    <TextBlock Text="{l:T Savdo_Xarajatlar}" Classes="kichikSarlavha" />
                                    <TextBlock Text="{Binding XarajatIzoh}" Classes="izoh" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="{l:T Savdo_XarajatYoq}" Classes="izoh" IsVisible="{Binding XarajatYoq}" Margin="0,6" />
                            <ItemsControl ItemsSource="{Binding Xarajatlar}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:YozuvQatori">
                                        <Border BorderBrush="{DynamicResource Chiziq}" BorderThickness="0,0,0,1" Padding="0,12">
                                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                                                <StackPanel Spacing="2">
                                                    <TextBlock Text="{Binding Sarlavha}" FontWeight="Bold" FontSize="14" TextWrapping="Wrap" />
                                                    <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left"><TextBlock Text="{Binding Izoh}" Classes="izoh" /></Viewbox>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding Summa}" FontSize="17" FontWeight="ExtraBold" VerticalAlignment="Center" />
                                                <Button Grid.Column="2" Classes="ikon ochirX" VerticalAlignment="Center" IsVisible="{Binding OchirishMumkin}" ToolTip.Tip="{l:T Ochirish}"
                                                        Command="{Binding $parent[UserControl].((vm:SavdoViewModel)DataContext).OchirCommand}" CommandParameter="{Binding}">
                                                    <ctl:Ikon Nomi="x" Olcham="13" />
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" Margin="0,2,0,0">
                                <TextBlock Text="{l:T Savdo_Jami}" FontWeight="Bold" VerticalAlignment="Center" />
                                <StackPanel Orientation="Horizontal" Grid.Column="1" HorizontalAlignment="Right"><TextBlock Text="{Binding XarajatJami}" FontSize="20" FontWeight="ExtraBold" VerticalAlignment="Bottom" /><TextBlock Text=" " VerticalAlignment="Bottom" /><TextBlock Text="{l:T Som}" FontSize="12" VerticalAlignment="Bottom" /></StackPanel>
                            </Grid>
                            <Button Classes="primary" HorizontalAlignment="Stretch" IsVisible="{Binding XarajatYozaOladi}" Command="{Binding XarajatYozCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="8"><ctl:Ikon Nomi="plus" Olcham="15" /><TextBlock Text="{l:T Xarajat_Yozish}" /></StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Nasiyalar kartasi (§8.7): muddati o'tgan bo'lsa — qizil "Muddati o'tgan qarzlar", aks holda neytral "Nasiyalar" -->
                    <Border Classes="card nasiyaKarta" Classes.otgan="{Binding OtganBor}" Padding="20,18" VerticalAlignment="Top" IsVisible="{Binding OtganKorinsin}">
                        <Border.Styles>
                            <Style Selector="Border.nasiyaKarta.otgan">
                                <Setter Property="Background" Value="{DynamicResource KamomatFon}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource KamomatChegara}" />
                            </Style>
                        </Border.Styles>
                        <StackPanel Spacing="12">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <Panel>
                                    <Border Classes="ikonDoira" Width="40" Height="40" Background="{DynamicResource BadgeQizilFon}" IsVisible="{Binding OtganBor}">
                                        <ctl:Ikon Nomi="alert" Olcham="18" Rang="{DynamicResource Qizil}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <Border Classes="ikonDoira" Width="40" Height="40" Background="{DynamicResource BadgeKokFon}" IsVisible="{Binding !OtganBor}">
                                        <ctl:Ikon Nomi="book" Olcham="18" Rang="{DynamicResource BadgeKokMatn}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </Panel>
                                <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding NasiyaKartaSarlavha}" Classes="kichikSarlavha" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding OtganIzoh}" Classes="izoh" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                            <Border Background="{DynamicResource IchkiTile}" CornerRadius="14" Padding="14,10">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                    <ctl:Ikon Nomi="wallet" Olcham="15" Rang="{DynamicResource MatnYumshoq}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding JamiQarzdorlik}" FontWeight="Bold" FontSize="13.5" TextWrapping="Wrap" />
                                </Grid>
                            </Border>
                            <ItemsControl ItemsSource="{Binding OtganQarzlar}" IsVisible="{Binding OtganRoyxatBor}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:OtganQarz">
                                        <Border BorderBrush="{DynamicResource Chiziq}" BorderThickness="0,0,0,1" Padding="0,12">
                                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="6">
                                                <TextBlock Text="{Binding N.MijozIsmi}" FontWeight="Bold" FontSize="14" TextTrimming="CharacterEllipsis" Margin="0,0,10,0" />
                                                <TextBlock Grid.Column="1" Text="{Binding Summa}" FontSize="17" FontWeight="ExtraBold" HorizontalAlignment="Right" />
                                                <WrapPanel Grid.Row="1" ItemSpacing="6" LineSpacing="4" Margin="0,0,8,0">
                                                    <Border Classes="davlatRaqam" IsVisible="{Binding RaqamBor}"><TextBlock Text="{Binding Raqam}" /></Border>
                                                    <TextBlock Text="{Binding MuddatEdi}" Classes="izoh" VerticalAlignment="Center" />
                                                </WrapPanel>
                                                <Border Grid.Row="1" Grid.Column="1" Classes="badge" ctl:Klass.Nomi="{Binding KunKlassi}" HorizontalAlignment="Right"><TextBlock Text="{Binding KunOtdi}" /></Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button HorizontalAlignment="Stretch" Command="{Binding BarchaNasiyalarCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="{l:T Savdo_BarchaNasiyalar}" /><ctl:Ikon Nomi="arrow" Olcham="15" /></StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </ctl:Moslashuvchan>
            </StackPanel>
        </ScrollViewer>

        <!-- ===================================================== 2. SMENA YOPIQ: OCHISH FORMASI ===================================================== -->
        <ScrollViewer IsVisible="{Binding YopiqKorinsin}" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="28,22,28,28" Spacing="18">
                <StackPanel Spacing="8">
                    <TextBlock Text="{l:T Savdo}" Classes="sarlavha" FontSize="28" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border Classes="badge kulrang"><StackPanel Orientation="Horizontal" Spacing="7"><Ellipse Width="7" Height="7" Fill="{DynamicResource BadgeKulrangMatn}" VerticalAlignment="Center" /><TextBlock Text="{l:T Savdo_SmenaYopiq}" /></StackPanel></Border>
                        <TextBlock Text="{Binding SmenaIzoh}" Classes="izoh" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </StackPanel>

                <Grid ColumnDefinitions="*,340" ColumnSpacing="18">
                    <Border Classes="card" Padding="24,22" VerticalAlignment="Top">
                        <StackPanel Spacing="16">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{l:T Savdo_SmenaniOchish}" FontSize="20" FontWeight="ExtraBold" />
                                <TextBlock Text="{l:T Savdo_OchishIzoh}" Classes="izoh" FontSize="13" TextWrapping="Wrap" />
                            </StackPanel>

                            <Border Classes="ogoh" IsVisible="{Binding AparatYoq}">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                    <ctl:Ikon Nomi="alert" Olcham="17" Rang="{DynamicResource OgohMatn}" VerticalAlignment="Top" Margin="0,1,0,0" />
                                    <TextBlock Grid.Column="1" Text="{l:T Bosh_AparatYoq}" TextWrapping="Wrap" />
                                    <Button Grid.Column="2" VerticalAlignment="Center" IsVisible="{Binding SozlamalarOchaOladi}" Command="{Binding SozlamalargaOtCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="8"><ctl:Ikon Nomi="gear" Olcham="15" /><TextBlock Text="{l:T Sozlamalar}" /></StackPanel>
                                    </Button>
                                </Grid>
                            </Border>

                            <Border Classes="malumot" IsVisible="{Binding OchishRuxsatiYoq}"><TextBlock Text="{l:T Savdo_OchishRuxsatYoq}" TextWrapping="Wrap" /></Border>

                            <StackPanel Spacing="14" IsVisible="{Binding OchaOladi}">
                                <Border Classes="ichki">
                                    <Grid ColumnDefinitions="Auto,*,0.9*" ColumnSpacing="16">
                                        <Border Classes="ikonDoira" Background="{DynamicResource BadgeKokFon}">
                                            <ctl:Ikon Nomi="cash" Olcham="19" Rang="{DynamicResource BadgeKokMatn}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                            <TextBlock Text="{l:T Savdo_QaytimPuli}" FontWeight="Bold" FontSize="14.5" TextWrapping="Wrap" />
                                            <TextBlock Text="{l:T Savdo_QaytimIzoh}" Classes="izoh" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <TextBox Grid.Column="2" Classes="orta" MaxWidth="280" VerticalAlignment="Center" Text="{Binding OchQaytim}" ctl:PulMaydon.Yoqilgan="True" PlaceholderText="0" ctl:AvtoFokus.Yoqilgan="True" ctl:EnterTartib.Guruh="ochish" />
                                    </Grid>
                                </Border>
                                <Border Classes="ichki">
                                    <Grid ColumnDefinitions="Auto,*,0.9*" ColumnSpacing="16">
                                        <Border Classes="ikonDoira" Background="#2619B5C9">
                                            <ctl:Ikon Nomi="card" Olcham="19" Rang="#0E8A9A" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                            <TextBlock Text="{l:T Savdo_TerminalSumma}" FontWeight="Bold" FontSize="14.5" TextWrapping="Wrap" />
                                            <TextBlock Text="{l:T Savdo_TerminalSummaIzoh}" Classes="izoh" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <TextBox Grid.Column="2" Classes="orta" MaxWidth="280" VerticalAlignment="Center" Text="{Binding OchTerminal}" ctl:PulMaydon.Yoqilgan="True" PlaceholderText="0" ctl:EnterTartib.Guruh="ochish" />
                                    </Grid>
                                </Border>
                                <Border Classes="ichki">
                                    <Grid ColumnDefinitions="Auto,*,0.9*" ColumnSpacing="16">
                                        <Border Classes="ikonDoira" Background="{DynamicResource BadgeBinafshaFon}">
                                            <ctl:Ikon Nomi="wallet" Olcham="19" Rang="{DynamicResource BadgeBinafshaMatn}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                            <TextBlock Text="{l:T Savdo_DepozitQoldigi}" FontWeight="Bold" FontSize="14.5" TextWrapping="Wrap" />
                                            <TextBlock Text="{l:T Savdo_DepozitQoldigiIzoh}" Classes="izoh" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <TextBox Grid.Column="2" Classes="orta" MaxWidth="280" VerticalAlignment="Center" Text="{Binding OchDepozit}" ctl:PulMaydon.Yoqilgan="True" PlaceholderText="0" ctl:EnterTartib.Guruh="ochish" />
                                    </Grid>
                                </Border>
                                <TextBlock Text="{Binding OchishXato}" Classes="xatoMatn" IsVisible="{Binding OchishXato, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                    <Border Classes="avatar" Width="34" Height="34"><TextBlock Text="{Binding JoriyHarflar}" FontSize="12" /></Border>
                                    <TextBlock Grid.Column="1" Text="{Binding OchishFooter}" Classes="izoh" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <Button Grid.Column="2" Classes="success" Height="52" FontSize="16" Padding="36,0" Command="{Binding SmenaOchCommand}" ctl:EnterTartib.Guruh="ochish">
                                        <TextBlock Text="{l:T Savdo_SmenaniOchish}" />
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Column="1" Spacing="18">
                        <!-- §8.10: boshqa operator uchun — oldingi smena topshirish ma'lumoti (natija, kamomat ko'rsatilmaydi) -->
                        <Border Classes="card" Padding="20,18" IsVisible="{Binding TopshirishBor}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="{l:T Savdo_OldingiSmena}" FontSize="15" FontWeight="ExtraBold" />
                                <TextBlock Text="{Binding TopshirishSarlavha}" Classes="izoh" TextWrapping="Wrap" />
                                <Border Classes="ichki" Padding="14,10" IsVisible="{Binding TopshirishDepozitBor}">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{l:T Savdo_YopilgandagiDepozit}" Classes="qator" TextWrapping="Wrap" />
                                        <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left">
                                            <StackPanel Orientation="Horizontal"><TextBlock Text="{Binding TopshirishDepozit}" FontSize="18" FontWeight="ExtraBold" VerticalAlignment="Bottom" /><TextBlock Text=" " VerticalAlignment="Bottom" /><TextBlock Text="{l:T Som}" FontSize="12" VerticalAlignment="Bottom" /></StackPanel>
                                        </Viewbox>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="{l:T Savdo_TopshirishIzoh}" Classes="izoh" FontSize="12" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Border Classes="card" Padding="20,18" IsVisible="{Binding OxirgiBor}">
                            <StackPanel Spacing="8">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <TextBlock Text="{Binding OxirgiSarlavha}" FontSize="15" FontWeight="ExtraBold" TextTrimming="CharacterEllipsis" />
                                    <Border Grid.Column="1" Classes="badge kulrang"><TextBlock Text="{l:T Savdo_Yopilgan}" /></Border>
                                </Grid>
                                <TextBlock Text="{Binding OxirgiIzoh}" Classes="izoh" Margin="0,-6,0,4" TextTrimming="CharacterEllipsis" />
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><TextBlock Classes="qator" TextTrimming="CharacterEllipsis" Text="{l:T Savdo_SavdoQator}" /><TextBlock Grid.Column="1" Text="{Binding OxirgiSavdo}" FontWeight="ExtraBold" /></Grid>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><TextBlock Classes="qator" TextTrimming="CharacterEllipsis" Text="{l:T Savdo_SotilganLitr}" /><TextBlock Grid.Column="1" Text="{Binding OxirgiLitr}" FontWeight="ExtraBold" /></Grid>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><TextBlock Classes="qator" TextTrimming="CharacterEllipsis" Text="{l:T Savdo_Plastik}" /><TextBlock Grid.Column="1" Text="{Binding OxirgiPlastik}" FontWeight="ExtraBold" /></Grid>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><TextBlock Classes="qator" TextTrimming="CharacterEllipsis" Text="{l:T Savdo_DepozitFarqi}" /><TextBlock Grid.Column="1" Text="{Binding OxirgiDepozit}" FontWeight="ExtraBold" /></Grid>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><TextBlock Classes="qator" TextTrimming="CharacterEllipsis" Text="{l:T Savdo_Nasiya}" /><TextBlock Grid.Column="1" Text="{Binding OxirgiNasiya}" FontWeight="ExtraBold" /></Grid>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><TextBlock Classes="qator" TextTrimming="CharacterEllipsis" Text="{l:T Savdo_Xarajatlar}" /><TextBlock Grid.Column="1" Text="{Binding OxirgiXarajat}" FontWeight="ExtraBold" /></Grid>
                                <Border Classes="qizilTile" Padding="14,10" Margin="0,6,0,0" IsVisible="{Binding OxirgiKamomat}">
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="{l:T Savdo_Kamomat}" FontWeight="Bold" Foreground="{DynamicResource BadgeQizilMatn}" FontSize="12.5" />
                                        <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left"><TextBlock Text="{Binding OxirgiFarq}" FontSize="18" FontWeight="ExtraBold" Foreground="{DynamicResource Qizil}" /></Viewbox>
                                        <TextBlock Text="{Binding OxirgiFarqIzoh}" FontSize="12.5" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                <Border Classes="yashilTile" Padding="14,10" Margin="0,6,0,0" IsVisible="{Binding OxirgiOrtiqcha}">
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="{l:T Savdo_Ortiqcha}" FontWeight="Bold" Foreground="{DynamicResource YashilTileMatn}" FontSize="12.5" />
                                        <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left"><TextBlock Text="{Binding OxirgiFarq}" FontSize="18" FontWeight="ExtraBold" Foreground="{DynamicResource Yashil}" /></Viewbox>
                                        <TextBlock Text="{Binding OxirgiFarqIzoh}" FontSize="12.5" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                <Border Classes="yashilTile" Padding="14,10" Margin="0,6,0,0" IsVisible="{Binding OxirgiTeng}">
                                    <TextBlock Text="{l:T Savdo_FarqYoq}" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource YashilTileMatn}" />
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Classes="card" Padding="20,18" IsVisible="{Binding !AparatYoq}">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{l:T Savdo_AparatlarHolati}" FontSize="15" FontWeight="ExtraBold" />
                                <TextBlock Text="{Binding AparatlarHolatiIzoh}" Classes="izoh" Margin="0,0,0,10" TextWrapping="Wrap" />
                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="14">
                                    <TextBlock Text="{l:T Savdo_Aparat, Katta=True}" Classes="yorliq" />
                                    <TextBlock Grid.Column="1" Text="{l:T Savdo_Pult, Katta=True}" Classes="yorliq" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="2" Text="{l:T Savdo_Bak, Katta=True}" Classes="yorliq" HorizontalAlignment="Right" MinWidth="64" TextAlignment="Right" />
                                </Grid>
                                <ItemsControl ItemsSource="{Binding Aparatlar}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:AparatKartasi">
                                            <Border BorderBrush="{DynamicResource Chiziq}" BorderThickness="0,1,0,0" Padding="0,8">
                                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="14">
                                                    <Grid ColumnDefinitions="Auto,Auto,*"><TextBlock Text="{Binding A.Raqam}" FontWeight="Bold" FontSize="13" VerticalAlignment="Bottom" /><TextBlock Grid.Column="1" Text=" · " FontWeight="Bold" FontSize="13" VerticalAlignment="Bottom" /><TextBlock Grid.Column="2" Text="{Binding A.Yoqilgi.Nomi}" FontWeight="Bold" FontSize="13" VerticalAlignment="Bottom" TextTrimming="CharacterEllipsis" /></Grid>
                                                    <TextBlock Grid.Column="1" Text="{Binding Pult}" FontSize="13" HorizontalAlignment="Right" />
                                                    <TextBlock Grid.Column="2" Text="{Binding BakAniq}" FontSize="13" FontWeight="Bold" MinWidth="64" TextAlignment="Right"
                                                               Classes.manfiy="{Binding BakManfiy}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- ===================================================== 3. SMENANI YOPISH ===================================================== -->
        <ScrollViewer IsVisible="{Binding YopishRejimi}" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="28,22,28,28" Spacing="18">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{l:T Yopish_Sarlavha}" Classes="sarlavha" FontSize="28" TextTrimming="CharacterEllipsis" />
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <Border Classes="badge yashil"><StackPanel Orientation="Horizontal" Spacing="7"><Ellipse Width="7" Height="7" Fill="{DynamicResource BadgeYashilMatn}" VerticalAlignment="Center" /><TextBlock Text="{Binding YopishBelgi}" /></StackPanel></Border>
                            <TextBlock Grid.Column="1" Text="{Binding YopishIzohi}" Classes="izoh" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </StackPanel>
                    <Button Grid.Column="1" VerticalAlignment="Bottom" Command="{Binding SavdogaQaytCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8"><ctl:Ikon Nomi="back" Olcham="15" /><TextBlock Text="{l:T Yopish_SavdogaQaytish}" /></StackPanel>
                    </Button>
                </Grid>

                <!-- Tor ekranda (asosiy qismga 620 px dan kam qolsa) "Kassadagi naqd" paneli jadval ostiga tushadi -->
                <ctl:IkkiUstun YonEni="300" AsosiyMinEni="620" Oraliq="18">
                    <StackPanel Spacing="18">
                        <!-- 1. Aparat ko'rsatkichlari -->
                        <Border Classes="card" Padding="20,18">
                            <StackPanel Spacing="4">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" Margin="0,0,0,10">
                                    <Border Classes="qadam" VerticalAlignment="Top"><TextBlock Text="1" /></Border>
                                    <StackPanel Grid.Column="1" Spacing="1">
                                        <TextBlock Text="{l:T Yopish_AparatKorsatkichlari}" Classes="kichikSarlavha" />
                                        <TextBlock Text="{l:T Yopish_AparatIzoh}" Classes="izoh" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                                <StackPanel>
                                <Grid ColumnSpacing="10" Margin="4,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="1.45*" /><ColumnDefinition Width="1.15*" /><ColumnDefinition Width="1.5*" MinWidth="150" /><ColumnDefinition Width="1.1*" /><ColumnDefinition Width="0.75*" /><ColumnDefinition Width="1.25*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="{l:T Yopish_Aparat, Katta=True}" Classes="yorliq" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                    <TextBlock Grid.Column="1" Text="{l:T Yopish_Oldingi, Katta=True}" Classes="yorliq" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                    <TextBlock Grid.Column="2" Text="{l:T Yopish_Yangi, Katta=True}" Classes="yorliq" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                    <TextBlock Grid.Column="3" Text="{l:T Yopish_Sotilgan, Katta=True}" Classes="yorliq" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                    <TextBlock Grid.Column="4" Text="{l:T Yopish_Narx, Katta=True}" Classes="yorliq" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                    <TextBlock Grid.Column="5" Text="{l:T Yopish_Summa, Katta=True}" Classes="yorliq" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                </Grid>
                                <ItemsControl ItemsSource="{Binding YopishQatorlari}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:YopishQatori">
                                            <Border BorderBrush="{DynamicResource Chiziq}" BorderThickness="0,1,0,0" Padding="4,10">
                                                <StackPanel Spacing="4">
                                                    <Grid ColumnSpacing="10">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="1.45*" /><ColumnDefinition Width="1.15*" /><ColumnDefinition Width="1.5*" MinWidth="150" /><ColumnDefinition Width="1.1*" /><ColumnDefinition Width="0.75*" /><ColumnDefinition Width="1.25*" /></Grid.ColumnDefinitions>
                                                        <StackPanel Spacing="4" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Nomi}" FontSize="15" FontWeight="ExtraBold" TextTrimming="CharacterEllipsis" />
                                                            <Border Classes="yoqilgi" Background="{Binding Yoqilgi.Fon}" HorizontalAlignment="Left">
                                                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                                                                    <Ellipse Width="7" Height="7" Fill="{Binding Yoqilgi.Nuqta}" VerticalAlignment="Center" />
                                                                    <TextBlock Grid.Column="1" Text="{Binding Yoqilgi.Nomi}" Foreground="{Binding Yoqilgi.Matn}" TextTrimming="CharacterEllipsis" />
                                                                </Grid>
                                                            </Border>
                                                        </StackPanel>
                                                        <Viewbox Grid.Column="1" StretchDirection="DownOnly" HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock Text="{Binding OldingiMatn}" FontSize="14" Foreground="{DynamicResource MatnYumshoq}" /></Viewbox>
                                                        <TextBox Grid.Column="2" Classes="pult" Classes.xato="{Binding Xato}" Text="{Binding Yangi}" PlaceholderText="0.00" ctl:EnterTartib.Guruh="yopish" />
                                                        <Viewbox Grid.Column="3" StretchDirection="DownOnly" HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock Text="{Binding LitrMatn}" FontSize="14" FontWeight="ExtraBold" /></Viewbox>
                                                        <Viewbox Grid.Column="4" StretchDirection="DownOnly" HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock Text="{Binding NarxMatn}" FontSize="14" Foreground="{DynamicResource MatnYumshoq}" /></Viewbox>
                                                        <Viewbox Grid.Column="5" StretchDirection="DownOnly" HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock Text="{Binding SummaMatn}" FontSize="14" FontWeight="ExtraBold" /></Viewbox>
                                                    </Grid>
                                                    <TextBlock Text="{Binding XatoMatn}" Classes="xatoMatn" HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap" IsVisible="{Binding Xato}" />
                                                    <TextBlock Text="{Binding QaydMatn}" Classes="izoh" FontSize="12" TextWrapping="Wrap" IsVisible="{Binding QaydBor}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Border BorderBrush="{DynamicResource Chiziq}" BorderThickness="0,1,0,0" Padding="4,14,4,0">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="24">
                                        <TextBlock Text="{l:T Yopish_Jami}" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" />
                                        <Viewbox Grid.Column="1" StretchDirection="DownOnly" HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock Text="{Binding JamiLitrMatn}" FontSize="15" FontWeight="ExtraBold" /></Viewbox>
                                        <StackPanel Orientation="Horizontal" Grid.Column="2" VerticalAlignment="Center"><TextBlock Text="{Binding JamiSummaMatn}" FontSize="18" FontWeight="ExtraBold" Foreground="{DynamicResource ChiziqliMatn}" VerticalAlignment="Bottom" /><TextBlock Text=" " FontSize="18" FontWeight="ExtraBold" Foreground="{DynamicResource ChiziqliMatn}" VerticalAlignment="Bottom" /><TextBlock Text="{l:T Som}" FontSize="12" FontWeight="ExtraBold" Foreground="{DynamicResource ChiziqliMatn}" VerticalAlignment="Bottom" /></StackPanel>
                                    </Grid>
                                </Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- 2. Plastik va depozit -->
                        <Border Classes="card" Padding="20,18">
                            <StackPanel Spacing="14">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                    <Border Classes="qadam"><TextBlock Text="2" /></Border>
                                    <TextBlock Grid.Column="1" Text="{l:T Yopish_PlastikDepozit}" Classes="kichikSarlavha" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </Grid>
                                <ctl:Moslashuvchan ElementEni="230" MaksUstun="2" ColumnSpacing="14" RowSpacing="14">
                                    <Border Classes="ichki">
                                        <StackPanel Spacing="8">
                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                                <Border Width="34" Height="34" CornerRadius="17" Background="#2619B5C9">
                                                    <ctl:Ikon Nomi="card" Olcham="16" Rang="#0E8A9A" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="{l:T Yopish_PlastikTerminal}" FontWeight="Bold" VerticalAlignment="Center" TextWrapping="Wrap" />
                                            </Grid>
                                            <TextBlock Text="{l:T Yopish_PlastikSummalari, Katta=True}" Classes="yorliq" Margin="0,4,0,0" />
                                            <!-- §8.9: bir nechta plastik summasi — har biri alohida qator (nomsiz), × bilan o'chiriladi -->
                                            <ItemsControl x:Name="PlastikRoyxat" ItemsSource="{Binding PlastikQatorlari}">
                                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="8" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:PlastikQatori">
                                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                            <TextBox Classes="orta" Classes.xato="{Binding Xato}" Text="{Binding Summa}" ctl:PulMaydon.Yoqilgan="True" PlaceholderText="{Binding SummaYorligi}" AutomationProperties.Name="{Binding SummaYorligi}" ctl:EnterTartib.Guruh="yopish" />
                                                            <Button Grid.Column="1" Classes="ikon" VerticalAlignment="Center" ToolTip.Tip="{Binding OchirishYorligi}" AutomationProperties.Name="{Binding OchirishYorligi}"
                                                                    Command="{Binding $parent[UserControl].((vm:SavdoViewModel)DataContext).PlastikOchirCommand}" CommandParameter="{Binding}">
                                                                <ctl:Ikon Nomi="x" Olcham="13" />
                                                            </Button>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <Button HorizontalAlignment="Left" Command="{Binding PlastikQoshCommand}" IsEnabled="{Binding PlastikQoshMumkin}">
                                                <StackPanel Orientation="Horizontal" Spacing="6"><ctl:Ikon Nomi="plus" Olcham="14" /><TextBlock Text="{l:T Yopish_PlastikQosh}" /></StackPanel>
                                            </Button>
                                            <TextBlock Text="{l:T Yopish_PlastikIzoh}" Classes="izoh" TextWrapping="Wrap" />
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" IsVisible="{Binding PlastikKopQator}">
                                                <TextBlock Text="{l:T Yopish_JamiPlastik}" FontWeight="Bold" FontSize="13" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="1" Text="{Binding JamiPlastikMatn}" FontWeight="ExtraBold" />
                                            </Grid>
                                            <Border Classes="chiziq" Margin="0,4" />
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10"><TextBlock Classes="qator" Text="{l:T Yopish_OchishdaYozilgan}" TextTrimming="CharacterEllipsis" /><TextBlock Grid.Column="1" Text="{Binding OchishTerminal}" FontWeight="Bold" /></Grid>
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10"><TextBlock Text="{l:T Yopish_ShuSmenaPlastik}" FontWeight="Bold" FontSize="13" TextTrimming="CharacterEllipsis" /><TextBlock Grid.Column="1" Text="{Binding ShuSmenaPlastikMatn}" FontWeight="ExtraBold" Classes.manfiy="{Binding PlastikKam}" /></Grid>
                                            <TextBlock Text="{l:T Yopish_PlastikKam}" Classes="xatoMatn" IsVisible="{Binding PlastikKam}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                    <Border Classes="ichki">
                                        <StackPanel Spacing="8">
                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                                <Border Width="34" Height="34" CornerRadius="17" Background="{DynamicResource BadgeBinafshaFon}">
                                                    <ctl:Ikon Nomi="wallet" Olcham="16" Rang="{DynamicResource BadgeBinafshaMatn}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="{l:T Yopish_DepozitKarta}" FontWeight="Bold" VerticalAlignment="Center" TextWrapping="Wrap" />
                                            </Grid>
                                            <TextBlock Text="{l:T Yopish_KartadagiQoldiq, Katta=True}" Classes="yorliq" Margin="0,4,0,0" />
                                            <TextBox Classes="orta" Classes.xato="{Binding DepozitXato}" Text="{Binding YopDepozit}" ctl:PulMaydon.Yoqilgan="True" PlaceholderText="0" ctl:EnterTartib.Guruh="yopish" />
                                            <TextBlock Text="{l:T Yopish_DepozitIzoh}" Classes="izoh" TextWrapping="Wrap" />
                                            <Border Classes="chiziq" Margin="0,4" />
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10"><TextBlock Classes="qator" Text="{l:T Yopish_OchishdaYozilgan}" TextTrimming="CharacterEllipsis" /><TextBlock Grid.Column="1" Text="{Binding OchishDepozit}" FontWeight="Bold" /></Grid>
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10"><TextBlock Text="{l:T Yopish_DepozitFarqi}" FontWeight="Bold" FontSize="13" TextTrimming="CharacterEllipsis" /><TextBlock Grid.Column="1" Text="{Binding DepozitFarqiMatn}" FontWeight="ExtraBold" /></Grid>
                                            <Border Classes="malumot" Padding="12,8" IsVisible="{Binding DepozitManfiy}"><TextBlock Text="{l:T Yopish_DepozitManfiy}" FontSize="12" TextWrapping="Wrap" /></Border>
                                        </StackPanel>
                                    </Border>
                                </ctl:Moslashuvchan>
                            </StackPanel>
                        </Border>

                        <!-- 3. Shu smenadagi yozuvlar -->
                        <Border Classes="card" Padding="20,18">
                            <StackPanel Spacing="14">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                    <Border Classes="qadam" VerticalAlignment="Top"><TextBlock Text="3" /></Border>
                                    <StackPanel Grid.Column="1" Spacing="1">
                                        <TextBlock Text="{l:T Yopish_Yozuvlar}" Classes="kichikSarlavha" />
                                        <TextBlock Text="{l:T Yopish_YozuvlarIzoh}" Classes="izoh" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="14" RowSpacing="14">
                                    <Border Classes="ichki" VerticalAlignment="Top">
                                        <StackPanel Spacing="6">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                <TextBlock Text="{l:T Yopish_NasiyaBerildi}" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                                                <Border Grid.Column="1" Classes="badge olov"><TextBlock Text="{Binding NasiyaSoniBelgi}" /></Border>
                                            </Grid>
                                            <ItemsControl ItemsSource="{Binding Nasiyalar}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:YozuvQatori">
                                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" Margin="0,3"><TextBlock Text="{Binding Sarlavha}" Classes="qator" TextTrimming="CharacterEllipsis" /><TextBlock Grid.Column="1" Text="{Binding Summa}" FontWeight="Bold" FontSize="13" /></Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <Border Classes="chiziq" />
                                            <Grid ColumnDefinitions="*,Auto"><TextBlock Text="{l:T Yopish_Jami}" FontWeight="Bold" FontSize="13" /><TextBlock Grid.Column="1" Text="{Binding NasiyaJami}" FontWeight="ExtraBold" FontSize="13" /></Grid>
                                            <Button Classes="chiziqli" Content="{l:T Nasiya_Yozish}" IsVisible="{Binding NasiyaYozaOladi}" Command="{Binding NasiyaYozCommand}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="1" Classes="ichki" VerticalAlignment="Top">
                                        <StackPanel Spacing="6">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                <TextBlock Text="{l:T Yopish_QaytganNasiya}" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                                                <Border Grid.Column="1" Classes="badge yashil"><TextBlock Text="{Binding QaytishSoniBelgi}" /></Border>
                                            </Grid>
                                            <ItemsControl ItemsSource="{Binding Qaytishlar}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:YozuvQatori">
                                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" Margin="0,3"><TextBlock Text="{Binding Sarlavha}" Classes="qator" TextTrimming="CharacterEllipsis" /><TextBlock Grid.Column="1" Text="{Binding Summa}" FontWeight="Bold" FontSize="13" /></Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <Border Classes="chiziq" />
                                            <Grid ColumnDefinitions="*,Auto"><TextBlock Text="{l:T Yopish_Jami}" FontWeight="Bold" FontSize="13" /><TextBlock Grid.Column="1" Text="{Binding QaytganJami}" FontWeight="ExtraBold" FontSize="13" /></Grid>
                                            <Button Classes="chiziqli" Content="{l:T Nasiya_QarzQaytdi}" IsVisible="{Binding QarzQaytdiOladi}" Command="{Binding QarzQaytdiCommand}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Row="1" Classes="ichki" VerticalAlignment="Top">
                                        <StackPanel Spacing="6">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                <TextBlock Text="{l:T Yopish_Xarajatlar}" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                                                <Border Grid.Column="1" Classes="badge sariq"><TextBlock Text="{Binding XarajatSoniBelgi}" /></Border>
                                            </Grid>
                                            <ItemsControl ItemsSource="{Binding Xarajatlar}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:YozuvQatori">
                                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" Margin="0,3"><TextBlock Text="{Binding Sarlavha}" Classes="qator" TextTrimming="CharacterEllipsis" /><TextBlock Grid.Column="1" Text="{Binding Summa}" FontWeight="Bold" FontSize="13" /></Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <Border Classes="chiziq" />
                                            <Grid ColumnDefinitions="*,Auto"><TextBlock Text="{l:T Yopish_Jami}" FontWeight="Bold" FontSize="13" /><TextBlock Grid.Column="1" Text="{Binding XarajatJami}" FontWeight="ExtraBold" FontSize="13" /></Grid>
                                            <Button Classes="chiziqli" Content="{l:T Xarajat_Yozish}" IsVisible="{Binding XarajatYozaOladi}" Command="{Binding XarajatYozCommand}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- 4. Kassadagi naqd -->
                    <Border Grid.Column="1" Classes="deep" Padding="22,22" VerticalAlignment="Top">
                        <StackPanel Spacing="9">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" Margin="0,0,0,6">
                                <Border Width="28" Height="28" CornerRadius="14" Background="#40FFFFFF"><TextBlock Text="4" Foreground="White" FontWeight="ExtraBold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                                <TextBlock Grid.Column="1" Text="{l:T Yopish_KassadagiNaqd}" Foreground="White" FontSize="17" FontWeight="ExtraBold" VerticalAlignment="Center" TextWrapping="Wrap" />
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12"><TextBlock Classes="deepYorliq" Text="{l:T Yopish_QaytimOchishda}" TextWrapping="Wrap" MaxWidth="150" /><Viewbox Grid.Column="1" StretchDirection="DownOnly" HorizontalAlignment="Right" VerticalAlignment="Top"><TextBlock Classes="deepQiymat" Text="{Binding BQaytim}" /></Viewbox></Grid>
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12"><TextBlock Classes="deepYorliq" Text="{l:T Yopish_SavdoAparatlar}" TextWrapping="Wrap" MaxWidth="150" /><Viewbox Grid.Column="1" StretchDirection="DownOnly" HorizontalAlignment="Right" VerticalAlignment="Top"><TextBlock Classes="deepQiymat" Text="{Binding BSavdo}" /></Viewbox></Grid>
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12"><TextBlock Classes="deepYorliq" Text="{l:T Yopish_QaytganNasiya}" TextWrapping="Wrap" MaxWidth="150" /><Viewbox Grid.Column="1" StretchDirection="DownOnly" HorizontalAlignment="Right" VerticalAlignment="Top"><TextBlock Classes="deepQiymat" Text="{Binding BQaytgan}" /></Viewbox></Grid>
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12"><TextBlock Classes="deepYorliq" Text="{l:T Yopish_Plastik}" TextWrapping="Wrap" MaxWidth="150" /><Viewbox Grid.Column="1" StretchDirection="DownOnly" HorizontalAlignment="Right" VerticalAlignment="Top"><TextBlock Classes="deepQiymat" Text="{Binding BPlastik}" /></Viewbox></Grid>
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12"><TextBlock Classes="deepYorliq" Text="{l:T Yopish_DepozitFarqi}" TextWrapping="Wrap" MaxWidth="150" /><Viewbox Grid.Column="1" StretchDirection="DownOnly" HorizontalAlignment="Right" VerticalAlignment="Top"><TextBlock Classes="deepQiymat" Text="{Binding BDepozit}" /></Viewbox></Grid>
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12"><TextBlock Classes="deepYorliq" Text="{l:T Yopish_Nasiya}" TextWrapping="Wrap" MaxWidth="150" /><Viewbox Grid.Column="1" StretchDirection="DownOnly" HorizontalAlignment="Right" VerticalAlignment="Top"><TextBlock Classes="deepQiymat" Text="{Binding BNasiya}" /></Viewbox></Grid>
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12"><TextBlock Classes="deepYorliq" Text="{l:T Yopish_Xarajatlar}" TextWrapping="Wrap" MaxWidth="150" /><Viewbox Grid.Column="1" StretchDirection="DownOnly" HorizontalAlignment="Right" VerticalAlignment="Top"><TextBlock Classes="deepQiymat" Text="{Binding BXarajat}" /></Viewbox></Grid>
                            <Border Height="1" Background="#40FFFFFF" Margin="0,8" />
                            <TextBlock Text="{l:T Yopish_KassadaBolishiKerak, Katta=True}" Foreground="#D9FFFFFF" FontSize="11" FontWeight="Bold" LetterSpacing="1" />
                            <!-- Hisob chiqmasa: raqam o'rniga nima yetishmasligi (qaysi aparat, nega) va kiritilganlar bo'yicha taxminiy natija -->
                            <Border Background="#26FFFFFF" CornerRadius="16" Padding="14,12" IsVisible="{Binding HolatToliqEmas}">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="{l:T Yopish_ToliqEmas}" Foreground="White" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <ItemsControl ItemsSource="{Binding ToliqEmasSabablar}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6" Margin="0,1">
                                                    <TextBlock Text="•" Foreground="#FFD27A" FontWeight="ExtraBold" />
                                                    <TextBlock Grid.Column="1" Text="{Binding}" Foreground="#FFE7B0" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="{Binding TaxminiyMatn}" Foreground="White" FontSize="12.5" TextWrapping="Wrap" IsVisible="{Binding TaxminiyBor}" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                            <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left" IsVisible="{Binding !HolatToliqEmas}"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Kutilgan}" FontSize="38" FontWeight="ExtraBold" LetterSpacing="-1" Foreground="White" VerticalAlignment="Bottom" /><TextBlock Text=" " Foreground="White" VerticalAlignment="Bottom" /><TextBlock Text="{l:T Som}" FontSize="14" FontWeight="Bold" Foreground="White" VerticalAlignment="Bottom" /></StackPanel></Viewbox>
                            <TextBlock Text="{l:T Yopish_SanalganNaqd, Katta=True}" Foreground="#D9FFFFFF" FontSize="11" FontWeight="Bold" LetterSpacing="1" Margin="0,6,0,0" />
                            <TextBox Classes="dialogKatta oq" Text="{Binding SanalganNaqd}" ctl:PulMaydon.Yoqilgan="True" PlaceholderText="0" ctl:EnterTartib.Guruh="yopish" />

                            <Border Classes="qizilTile" Padding="16,12" IsVisible="{Binding HolatKamomat}">
<StackPanel Spacing="4">
                                    <TextBlock Text="{l:T Savdo_Kamomat}" FontWeight="ExtraBold" Foreground="{DynamicResource BadgeQizilMatn}" FontSize="14" />
                                    <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left"><TextBlock Text="{Binding FarqMatn}" FontSize="26" FontWeight="ExtraBold" Foreground="{DynamicResource Qizil}" /></Viewbox>
                                    <TextBlock Text="{Binding KamomatIzoh}" FontSize="12.5" TextWrapping="Wrap" Foreground="{DynamicResource MatnYumshoq}" />
                                </StackPanel>
                            </Border>
                            <Border Classes="yashilTile" Padding="16,12" IsVisible="{Binding HolatOrtiqcha}">
<StackPanel Spacing="4">
                                    <TextBlock Text="{l:T Savdo_Ortiqcha}" FontWeight="ExtraBold" Foreground="{DynamicResource YashilTileMatn}" FontSize="14" />
                                    <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left"><TextBlock Text="{Binding FarqMatn}" FontSize="26" FontWeight="ExtraBold" Foreground="{DynamicResource Yashil}" /></Viewbox>
                                    <TextBlock Text="{l:T Yopish_OrtiqchaYoziladi}" FontSize="12.5" TextWrapping="Wrap" Foreground="{DynamicResource MatnYumshoq}" />
                                </StackPanel>
                            </Border>
                            <Border Classes="yashilTile" Padding="16,12" IsVisible="{Binding HolatTeng}">
                                <TextBlock Text="{l:T Savdo_FarqYoq}" FontWeight="ExtraBold" Foreground="{DynamicResource YashilTileMatn}" />
                            </Border>
                            <Border Background="#26FFFFFF" CornerRadius="16" Padding="16,12" IsVisible="{Binding HolatNaqd}">
                                <TextBlock Text="{l:T Yopish_NaqdniSanang}" Foreground="White" FontSize="12.5" TextWrapping="Wrap" />
                            </Border>

                            <TextBlock Text="{l:T Yopish_Izoh, Katta=True}" Foreground="#D9FFFFFF" FontSize="11" FontWeight="Bold" LetterSpacing="1" Margin="0,6,0,0" />
                            <TextBox Classes="oq" Text="{Binding Izoh}" PlaceholderText="{l:T Yopish_IzohPlaceholder}" />
                            <TextBlock Text="{Binding YopishXato}" Foreground="#FFD6D6" FontSize="12.5" TextWrapping="Wrap"
                                       IsVisible="{Binding YopishXato, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            <Button Classes="success" Height="54" FontSize="16" HorizontalAlignment="Stretch" Margin="0,6,0,0" Command="{Binding SmenaniYopCommand}" ctl:EnterTartib.Guruh="yopish">
                                <StackPanel Orientation="Horizontal" Spacing="8"><ctl:Ikon Nomi="check" Olcham="17" Rang="White" /><TextBlock Text="{l:T Savdo_SmenaniYopish}" /></StackPanel>
                            </Button>
                            <TextBlock Text="{l:T Yopish_YopilgachIzoh}" Foreground="#E6FFFFFF" FontSize="12.5" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                </ctl:IkkiUstun>
            </StackPanel>
        </ScrollViewer>
    </Panel>
</UserControl>
