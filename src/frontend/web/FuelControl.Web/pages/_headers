# Cloudflare Pages: sarlavhalar (faqat `npm run build:pages` natijasiga qo'shiladi, API wwwroot'iga emas).
# Eslatma: Pages bitta qoidada faqat bitta "*" ni qabul qiladi; mos kelgan qoidalarning sarlavhalari birlashtiriladi,
# shuning uchun Cache-Control beradigan qoidalar bir-biri bilan kesishmaydi.

# Barcha fayllar
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY

# Kirish nuqtalari, service worker va sozlama — doim yangisi (aks holda eski versiya/eski API manzili qolib ketadi)
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/sozlama.json
  Cache-Control: no-cache
/ngsw.json
  Cache-Control: no-cache
/ngsw-worker.js
  Cache-Control: no-cache
/safety-worker.js
  Cache-Control: no-cache
/worker-basic.min.js
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache
  Content-Type: application/manifest+json

# Hash'li fayllar (nomi tarkibiga bog'liq) — o'zgarmas
/main-*
  Cache-Control: public, max-age=31536000, immutable
/chunk-*
  Cache-Control: public, max-age=31536000, immutable
/styles-*
  Cache-Control: public, max-age=31536000, immutable
/polyfills-*
  Cache-Control: public, max-age=31536000, immutable

# Ikonkalar (hash'siz, kam o'zgaradi)
/icons/*
  Cache-Control: public, max-age=604800
