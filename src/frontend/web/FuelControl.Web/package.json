{
  "name": "fuel-control.web",
  "version": "0.1.0",
  "scripts": {
    "ng": "ng",
    "prestart": "node scripts/versiya.mjs",
    "start": "ng serve",
    "prebuild": "node scripts/versiya.mjs",
    "build": "ng build",
    "prewatch": "node scripts/versiya.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "api": "openapi-typescript http://localhost:5000/openapi/v1.json -o src/app/api/schema.d.ts",
    "lugat": "node scripts/lugat.mjs",
    "build:pages": "node scripts/versiya.mjs && ng build --configuration production,pages && node scripts/pages-sozlama.mjs"
  },
  "private": true,
  "packageManager": "npm@11.13.0",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@angular/service-worker": "^22.2.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@microsoft/signalr": "^10.0.11",
    "openapi-fetch": "^0.17.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "write-excel-file": "^4.1.1"
  },
  "devDependencies": {
    "@angular/build": "^22.2.1",
    "@angular/cli": "^22.2.1",
    "@angular/compiler-cli": "^22.2.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2"
  }
}
