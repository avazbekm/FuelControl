<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:FuelControl.Desktop.Controls"
             xmlns:vm="using:FuelControl.Desktop.ViewModels"
             xmlns:m="using:FuelControl.Desktop.Models"
             xmlns:ctl="using:FuelControl.Desktop.Controls"
             x:Class="FuelControl.Desktop.Views.OperatorlarView"
             x:DataType="vm:OperatorlarViewModel">

    <Panel>
        <Grid RowDefinitions="Auto,*" Margin="28,24,28,28" RowSpacing="16">
            <StackPanel Grid.Row="0" Spacing="3">
                <TextBlock Text="{l:T OperatorlarHisobi}" Classes="sarlavha" />
                <TextBlock Text="{l:T OperatorlarIzoh}" Classes="izoh" />
            </StackPanel>

            <Grid Grid.Row="1" ColumnDefinitions="372,*" ColumnSpacing="8">
                <!-- Operator kartalari: ScrollViewer kesmasligi uchun ichki padding -->
                <ScrollViewer Grid.Column="0" Padding="16,4,16,24" Margin="-16,-4,0,0">
                    <ItemsControl ItemsSource="{Binding Kartalar}" ClipToBounds="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:OperatorKartasi">
                                <Button Classes="karta" Margin="0,0,0,14"
                                        Command="{Binding $parent[UserControl].((vm:OperatorlarViewModel)DataContext).OperatorniTanlaCommand}" CommandParameter="{Binding}">
                                    <Border Classes="card" Padding="16" Classes.tanlangan="{Binding Tanlangan}">
                                        <Border.Styles>
                                            <Style Selector="Border.tanlangan"><Setter Property="BorderBrush" Value="#2F6BFF" /><Setter Property="BorderThickness" Value="2" /><Setter Property="BoxShadow" Value="0 12 28 0 #2E2F6BFF" /></Style>
                                        </Border.Styles>
                                        <StackPanel Spacing="12">
                                            <Grid ColumnDefinitions="44,*,Auto">
                                                <Border Classes="avatar" Width="44" Height="44">
                                                    <TextBlock Text="{Binding Operator.BoshHarflar}" />
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Spacing="2">
                                                    <TextBlock Text="{Binding Operator.ToliqIsm}" FontWeight="SemiBold" FontSize="14" />
                                                    <TextBlock Classes="izoh"><Run Text="{l:T Maosh}" /><Run Text=": " /><Run Text="{Binding Maosh}" /></TextBlock>
                                                </StackPanel>
                                                <Border Grid.Column="2" Classes="badge yashil" IsVisible="{Binding SmenadaMi}" VerticalAlignment="Top"><TextBlock Text="{l:T Smenada}" /></Border>
                                            </Grid>
                                            <Border Height="1" Background="{DynamicResource Chiziq}" />
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Text="{l:T JoriyQoldiq}" Classes="izoh" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{Binding QoldiqMatni}" FontSize="18" FontWeight="Bold"
                                                           Classes.manfiy="{Binding QoldiqManfiy}" Classes.musbat="{Binding !QoldiqManfiy}" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Tanlangan operator tafsiloti -->
                <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*" RowSpacing="14" IsVisible="{Binding TanlanganBormi}">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="2">
                            <TextBlock Text="{Binding Tanlangan.Operator.ToliqIsm}" Classes="kichikSarlavha" FontSize="18" />
                            <TextBlock Text="{l:T ShuOyKorsatkich}" Classes="izoh" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <Button Classes="ghost" Command="{Binding VaraqaniOchCommand}"><StackPanel Orientation="Horizontal" Spacing="8"><ctl:Ikon Nomi="file" Olcham="16" /><TextBlock Text="{l:T HisobVaraqa}" /></StackPanel></Button>
                            <Button Classes="primary" Command="{Binding AvansniOchCommand}" IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext).KoradiAvans}"><StackPanel Orientation="Horizontal" Spacing="8"><ctl:Ikon Nomi="plus" Olcham="16" /><TextBlock Text="{l:T AvansTolov}" /></StackPanel></Button>
                        </StackPanel>
                    </Grid>

                    <UniformGrid Grid.Row="1" Columns="5" ColumnSpacing="12">
                        <Border Classes="kpi"><StackPanel Spacing="4"><TextBlock Text="{l:T OylikSavdo, Katta=True}" Classes="nom" /><TextBlock Text="{Binding Tanlangan.OySavdo}" Classes="qiymat" FontSize="18" /></StackPanel></Border>
                        <Border Classes="kpi"><StackPanel Spacing="4"><TextBlock Text="{l:T Smenalar, Katta=True}" Classes="nom" /><TextBlock Text="{Binding Tanlangan.OySmenalar}" Classes="qiymat" FontSize="18" /></StackPanel></Border>
                        <Border Classes="kpi"><StackPanel Spacing="4"><TextBlock Text="{l:T AvansOldi, Katta=True}" Classes="nom" /><TextBlock Text="{Binding Tanlangan.OyAvans}" Classes="qiymat" FontSize="18" Foreground="{DynamicResource Sariq}" /></StackPanel></Border>
                        <Border Classes="kpi"><StackPanel Spacing="4"><TextBlock Text="{l:T Kamomat, Katta=True}" Classes="nom" /><TextBlock Text="{Binding Tanlangan.OyKamomat}" Classes="qiymat" FontSize="18" Foreground="{DynamicResource Qizil}" /></StackPanel></Border>
                        <Border Classes="kpi"><StackPanel Spacing="4"><TextBlock Text="{l:T Ortiqcha, Katta=True}" Classes="nom" /><TextBlock Text="{Binding Tanlangan.OyOrtiqcha}" Classes="qiymat" FontSize="18" Foreground="{DynamicResource Yashil}" /></StackPanel></Border>
                    </UniformGrid>

                    <Border Grid.Row="2" Classes="card" Padding="8">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="{l:T HisobHarakatlari}" Classes="kichikSarlavha" Margin="12,8,0,10" />
                            <DataGrid ItemsSource="{Binding Harakatlar}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{l:T Sana}" Binding="{Binding Sana, StringFormat='dd.MM.yyyy'}" Width="120" />
                                    <DataGridTemplateColumn Header="{l:T Turi}" Width="140">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate x:DataType="m:HisobHarakati">
                                                <TextBlock Text="{Binding TuriNomi}" VerticalAlignment="Center" FontWeight="SemiBold" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="{l:T Izoh}" Binding="{Binding Izoh}" Width="*" />
                                    <DataGridTextColumn Header="{l:T KimYozdi}" Binding="{Binding KimYozdi}" Width="170" />
                                    <DataGridTextColumn Header="{l:T Summa}" Binding="{Binding Summa, StringFormat='+#,0;−#,0;0'}" Width="130" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- ============ Avans / to'lov dialogi ============ -->
        <Border Classes="parda" IsVisible="{Binding AvansOchiq}">
            <Border Classes="dialog" Width="460">
                <StackPanel Spacing="16">
                    <StackPanel Spacing="3">
                        <TextBlock Text="{l:T PulBerish}" Classes="sarlavha" />
                        <TextBlock Text="{Binding Tanlangan.Operator.ToliqIsm}" Classes="izoh" />
                    </StackPanel>
                    <UniformGrid Columns="2" ColumnSpacing="10">
                        <Button Classes="tolov" Classes.tanlangan="{Binding AvansTanlangan}" Content="{l:T Avans}" Command="{Binding AvansTuriniTanlaCommand}" CommandParameter="0" />
                        <Button Classes="tolov" Classes.tanlangan="{Binding TolovTanlangan}" Content="{l:T MaoshTolovi}" Command="{Binding AvansTuriniTanlaCommand}" CommandParameter="1" />
                    </UniformGrid>
                    <StackPanel>
                        <TextBlock Text="{l:T SummaSom, Katta=True}" Classes="yorliq" />
                        <TextBox Text="{Binding AvansSumma}" Classes="katta" PlaceholderText="0" ctl:AvtoFokus.Yoqilgan="True" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="{l:T Izoh, Katta=True}" Classes="yorliq" />
                        <TextBox Text="{Binding AvansIzoh}" PlaceholderText="{l:T IzohMisol2}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                        <Button Classes="ghost" Content="{l:T BekorQilish}" Command="{Binding AvansniYopCommand}" />
                        <Button Classes="primary" Content="{l:T Saqlash}" Command="{Binding AvansniSaqlaCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- ============ Hisob-varaqa dialogi ============ -->
        <Border Classes="parda" IsVisible="{Binding VaraqaOchiq}">
            <Border Classes="dialog" Width="760" MaxHeight="720">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,14">
                        <StackPanel Spacing="3">
                            <TextBlock Text="{l:T HisobVaraqa}" Classes="sarlavha" FontSize="22" />
                            <TextBlock Text="{Binding Tanlangan.Operator.ToliqIsm}" Classes="izoh" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Button Classes="ikon" Command="{Binding OldingiOyCommand}" ToolTip.Tip="{l:T OldingiOy}"><ctl:Ikon Nomi="back" Olcham="16" /></Button>
                            <TextBlock Text="{Binding VaraqaDavr}" FontWeight="Bold" VerticalAlignment="Center" MinWidth="130" TextAlignment="Center" />
                            <Button Classes="ikon" Command="{Binding KeyingiOyCommand}" ToolTip.Tip="{l:T KeyingiOy}"><ctl:Ikon Nomi="arrow" Olcham="16" /></Button>
                        </StackPanel>
                    </Grid>

                    <UniformGrid DockPanel.Dock="Top" Columns="4" ColumnSpacing="10" Margin="0,0,0,14">
                        <Border Classes="tile"><StackPanel Spacing="3"><TextBlock Text="{l:T BoshlangichQoldiq, Katta=True}" Classes="yorliq" Margin="0" TextWrapping="Wrap" FontSize="10" /><TextBlock Text="{Binding VaraqaBoshlangich}" FontWeight="ExtraBold" FontSize="16" /></StackPanel></Border>
                        <Border Classes="tile"><StackPanel Spacing="3"><TextBlock Text="{l:T Jami_Kirim, Katta=True}" Classes="yorliq" Margin="0" TextWrapping="Wrap" FontSize="10" /><TextBlock Text="{Binding VaraqaKirim}" FontWeight="ExtraBold" FontSize="16" Foreground="{DynamicResource Yashil}" /></StackPanel></Border>
                        <Border Classes="tile"><StackPanel Spacing="3"><TextBlock Text="{l:T Jami_Chiqim, Katta=True}" Classes="yorliq" Margin="0" TextWrapping="Wrap" FontSize="10" /><TextBlock Text="{Binding VaraqaChiqim}" FontWeight="ExtraBold" FontSize="16" Foreground="{DynamicResource Qizil}" /></StackPanel></Border>
                        <Border Classes="tile"><StackPanel Spacing="3"><TextBlock Text="{l:T YakuniyQoldiq, Katta=True}" Classes="yorliq" Margin="0" TextWrapping="Wrap" FontSize="10" /><TextBlock Text="{Binding VaraqaYakuniy}" FontWeight="ExtraBold" FontSize="16" Classes.manfiy="{Binding VaraqaYakuniyManfiy}" Classes.musbat="{Binding !VaraqaYakuniyManfiy}" /></StackPanel></Border>
                    </UniformGrid>

                    <StackPanel DockPanel.Dock="Bottom" Spacing="10" Margin="0,14,0,0">
                        <TextBlock Text="{Binding VaraqaXabar}" Classes="izoh" TextWrapping="Wrap" IsVisible="{Binding VaraqaXabar, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                            <Button Classes="ghost" Content="{l:T Yopish}" Command="{Binding VaraqaniYopCommand}" />
                            <Button Classes="primary" Command="{Binding VaraqaniEksportCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="8"><ctl:Ikon Nomi="excel" Olcham="16" /><TextBlock Text="{l:T ExcelgaChiqarish}" /></StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>

                    <DataGrid ItemsSource="{Binding VaraqaQatorlari}" MinHeight="200">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{l:T Sana}" Binding="{Binding Sana}" Width="110" />
                            <DataGridTextColumn Header="{l:T Turi}" Binding="{Binding Turi}" Width="130" />
                            <DataGridTextColumn Header="{l:T Izoh}" Binding="{Binding Izoh}" Width="*" />
                            <DataGridTemplateColumn Header="{l:T Summa}" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="vm:VaraqaQatori">
                                        <TextBlock Text="{Binding Summa}" VerticalAlignment="Center" TextAlignment="Right" Classes.musbat="{Binding Musbat}" Classes.manfiy="{Binding !Musbat}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="{l:T Qoldiq}" Binding="{Binding Qoldiq}" Width="120" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Border>
    </Panel>
</UserControl>
