<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:FuelControl.Desktop.Controls"
             xmlns:vm="using:FuelControl.Desktop.ViewModels"
             xmlns:m="using:FuelControl.Desktop.Models"
             x:Class="FuelControl.Desktop.Views.AuditView"
             x:DataType="vm:AuditViewModel">

    <Grid RowDefinitions="Auto,Auto,*" Margin="28,24,28,28" RowSpacing="16">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <StackPanel Spacing="3">
                <TextBlock Text="{l:T AuditJurnali}" Classes="sarlavha" />
                <TextBlock Text="{l:T AuditIzoh}" Classes="izoh" />
            </StackPanel>
            <TextBox Grid.Column="1" Text="{Binding Qidiruv}" PlaceholderText="{l:T Qidirish}" Width="280" VerticalAlignment="Center" />
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <Button Classes="chip" Classes.tanlangan="{Binding JurnalBolimi}" Content="{l:T BarchaAmallar}" Command="{Binding BolimniTanlaCommand}" CommandParameter="0" />
            <Button Classes="chip" Classes.tanlangan="{Binding BekorBolimi}" Content="{l:T BekorQilinganSotuvlar}" Command="{Binding BolimniTanlaCommand}" CommandParameter="1" />
        </StackPanel>

        <Border Grid.Row="2" Classes="card" Padding="8">
            <Panel>
                <DataGrid ItemsSource="{Binding Yozuvlar}" IsVisible="{Binding JurnalBolimi}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{l:T Vaqt}" Binding="{Binding Vaqt, StringFormat='dd.MM.yyyy HH:mm'}" Width="170" />
                        <DataGridTextColumn Header="{l:T Kim}" Binding="{Binding Kim}" Width="200" />
                        <DataGridTemplateColumn Header="{l:T Amal}" Width="190">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="m:AuditYozuvi">
                                    <TextBlock Text="{Binding Amal}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="{l:T Tafsilot}" Binding="{Binding Tafsilot}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>

                <DataGrid ItemsSource="{Binding BekorQilinganlar}" IsVisible="{Binding BekorBolimi}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#" Binding="{Binding Id}" Width="70" />
                        <DataGridTextColumn Header="{l:T Vaqt}" Binding="{Binding Vaqt, StringFormat='dd.MM.yyyy HH:mm'}" Width="170" />
                        <DataGridTextColumn Header="{l:T Operator}" Binding="{Binding Operator.ToliqIsm}" Width="190" />
                        <DataGridTextColumn Header="{l:T Yoqilgi}" Binding="{Binding YoqilgiNomi}" Width="90" />
                        <DataGridTextColumn Header="{l:T Litr}" Binding="{Binding Litr, StringFormat='0.00'}" Width="80" />
                        <DataGridTextColumn Header="{l:T Summa}" Binding="{Binding Summa, StringFormat='#,0'}" Width="110" />
                        <DataGridTextColumn Header="{l:T Sabab}" Binding="{Binding BekorSababi}" Width="*" />
                        <DataGridTextColumn Header="{l:T BekorQilgan}" Binding="{Binding BekorQilgan}" Width="180" />
                    </DataGrid.Columns>
                </DataGrid>
            </Panel>
        </Border>
    </Grid>
</UserControl>
