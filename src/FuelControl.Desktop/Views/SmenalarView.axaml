<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:FuelControl.Desktop.Controls"
             xmlns:vm="using:FuelControl.Desktop.ViewModels"
             xmlns:m="using:FuelControl.Desktop.Models"
             xmlns:ctl="using:FuelControl.Desktop.Controls"
             x:Class="FuelControl.Desktop.Views.SmenalarView"
             x:DataType="vm:SmenalarViewModel">

    <Grid RowDefinitions="Auto,Auto,*" Margin="28,24,28,28" RowSpacing="16">

        <!-- Sarlavha + filtrlar -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <StackPanel Spacing="3">
                <TextBlock Text="{l:T Smenalar}" Classes="sarlavha" />
                <TextBlock Text="{Binding JoriySmenaMatni}" Classes="izoh" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Classes="success" IsVisible="{Binding OchishMumkin}" Command="{Binding SmenaOchCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8"><ctl:Ikon Nomi="play" Olcham="16" Rang="White" /><TextBlock Text="{l:T SmenaOchish}" /></StackPanel>
                </Button>
                <Button Classes="chip" Content="{l:T Bugun}" Command="{Binding DavrniTanlaCommand}" CommandParameter="0" />
                <Button Classes="chip" Content="{l:T Kun7}" Command="{Binding DavrniTanlaCommand}" CommandParameter="1" />
                <Button Classes="chip" Content="{l:T ShuOy}" Command="{Binding DavrniTanlaCommand}" CommandParameter="2" />
                <Button Classes="chip" Content="{l:T Hammasi}" Command="{Binding DavrniTanlaCommand}" CommandParameter="3" />
                <ComboBox ItemsSource="{Binding OperatorFiltri}" SelectedItem="{Binding TanlanganOperator}" Width="200" Margin="8,0,0,0"
                          IsVisible="{Binding OperatorFiltriKorinsin}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="m:Foydalanuvchi"><TextBlock Text="{Binding ToliqIsm}" /></DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
        </Grid>

        <!-- KPI -->
        <UniformGrid Grid.Row="1" Columns="3" ColumnSpacing="14">
            <Border Classes="kpi">
                <StackPanel Spacing="4">
                    <TextBlock Text="{l:T HozirOchiq, Katta=True}" Classes="nom" />
                    <TextBlock Text="{Binding OchiqSoni}" Classes="qiymat" Foreground="{DynamicResource Yashil}" />
                </StackPanel>
            </Border>
            <Border Classes="kpi">
                <StackPanel Spacing="4">
                    <TextBlock Text="{l:T ShuOySmenalar, Katta=True}" Classes="nom" />
                    <TextBlock Text="{Binding OySmenalar}" Classes="qiymat" />
                </StackPanel>
            </Border>
            <Border Classes="kpi">
                <StackPanel Spacing="4">
                    <TextBlock Text="{l:T ShuOyKamomat, Katta=True}" Classes="nom" />
                    <TextBlock Text="{Binding OyKamomat}" Classes="qiymat" Foreground="{DynamicResource Qizil}" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Ro'yxat + tafsilot -->
        <Grid Grid.Row="2" ColumnDefinitions="*,520" ColumnSpacing="16">
            <Border Grid.Column="0" Classes="card" Padding="0">
                <DataGrid ItemsSource="{Binding Smenalar}" SelectedItem="{Binding Tanlangan}" Margin="8">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#" Binding="{Binding Id}" Width="60" />
                        <DataGridTextColumn Header="{l:T Operator}" Binding="{Binding Operator.ToliqIsm}" Width="*" />
                        <DataGridTextColumn Header="{l:T Boshlandi}" Binding="{Binding Boshlandi, StringFormat='dd.MM HH:mm'}" Width="130" />
                        <DataGridTextColumn Header="{l:T Davomiylik}" Binding="{Binding Davomiylik}" Width="120" />
                        <DataGridTextColumn Header="{l:T Sotuv}" Binding="{Binding SotuvSoni}" Width="80" />
                        <DataGridTextColumn Header="{l:T Jami}" Binding="{Binding KutilganJami, StringFormat='#,0'}" Width="130" />
                        <DataGridTemplateColumn Header="{l:T Farq}" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="m:Smena">
                                    <Panel VerticalAlignment="Center">
                                        <Border Classes="badge yashil" IsVisible="{Binding Ochiqmi}"><TextBlock Text="{l:T OchiqKichik}" /></Border>
                                        <TextBlock Text="{Binding Farq, StringFormat='+#,0;−#,0;0'}" IsVisible="{Binding !Ochiqmi}"
                                                   Classes.manfiy="{Binding KamomatBormi}" FontWeight="SemiBold" />
                                    </Panel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Tafsilot -->
            <Border Grid.Column="1" Classes="card" IsVisible="{Binding TanlanganBormi}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2">
                                <TextBlock Classes="kichikSarlavha"><Run Text="{l:T Smena}" /><Run Text=" #" /><Run Text="{Binding Tanlangan.Id}" /></TextBlock>
                                <TextBlock Text="{Binding Tanlangan.Operator.ToliqIsm}" Classes="izoh" />
                            </StackPanel>
                            <Border Grid.Column="1" Classes="badge yashil" IsVisible="{Binding Tanlangan.Ochiqmi}"><TextBlock Text="{l:T Ochiq}" /></Border>
                            <Border Grid.Column="1" Classes="badge kulrang" IsVisible="{Binding !Tanlangan.Ochiqmi}"><TextBlock Text="{l:T Yopilgan}" /></Border>
                        </Grid>

                        <Border Classes="tile">
                            <Grid ColumnDefinitions="*,Auto,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="8">
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{l:T Kutilgan}" Classes="jadvalSarlavha" Margin="0,0,16,0" />
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="{l:T Topshirilgan}" Classes="jadvalSarlavha" />
                                <TextBlock Grid.Row="1" Text="{l:T Naqd}" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Tanlangan.KutilganNaqd, StringFormat='#,0'}" Classes="pul" Margin="0,0,16,0" />
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Tanlangan.TopshirilganNaqd, StringFormat='#,0', TargetNullValue='—'}" Classes="pul" />
                                <TextBlock Grid.Row="2" Text="{l:T Plastik}" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Tanlangan.KutilganPlastik, StringFormat='#,0'}" Classes="pul" Margin="0,0,16,0" />
                                <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding Tanlangan.TopshirilganPlastik, StringFormat='#,0', TargetNullValue='—'}" Classes="pul" />
                                <TextBlock Grid.Row="3" Text="{l:T Click}" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Tanlangan.KutilganClick, StringFormat='#,0'}" Classes="pul" Margin="0,0,16,0" />
                                <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding Tanlangan.TopshirilganClick, StringFormat='#,0', TargetNullValue='—'}" Classes="pul" />
                                <TextBlock Grid.Row="4" Text="{l:T Jami}" FontWeight="Bold" />
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Tanlangan.KutilganJami, StringFormat='#,0'}" FontWeight="Bold" Margin="0,0,16,0" />
                                <TextBlock Grid.Row="4" Grid.Column="2" Text="{Binding Tanlangan.Farq, StringFormat='+#,0;−#,0;0'}" FontWeight="Bold" />
                            </Grid>
                        </Border>

                        <Button Classes="primary" HorizontalAlignment="Stretch" IsVisible="{Binding YopishMumkin}" Command="{Binding YopishniBoshlaCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8"><ctl:Ikon Nomi="stop" Olcham="16" /><TextBlock Text="{l:T SmenaniYopish}" /></StackPanel>
                        </Button>

                        <TextBlock Text="{l:T SmenaSotuvlari}" Classes="kichikSarlavha" Margin="0,6,0,0" />
                    </StackPanel>

                    <DataGrid ItemsSource="{Binding TanlanganSotuvlar}" Margin="0,8,0,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{l:T Vaqt}" Binding="{Binding Vaqt, StringFormat='HH:mm'}" Width="78" />
                            <DataGridTextColumn Header="{l:T Ap}" Binding="{Binding Aparat.Raqam}" Width="50" />
                            <DataGridTextColumn Header="{l:T Yoqilgi}" Binding="{Binding YoqilgiNomi}" Width="*" />
                            <DataGridTextColumn Header="{l:T Litr}" Binding="{Binding Litr, StringFormat='0.00'}" Width="74" />
                            <DataGridTextColumn Header="{l:T Summa}" Binding="{Binding Summa, StringFormat='#,0'}" Width="96" />
                            <DataGridTextColumn Header="{l:T Tolov}" Binding="{Binding TolovNomi}" Width="84" />
                            <DataGridTemplateColumn Header="" Width="44">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="m:Sotuv">
                                        <Button Classes="ikon" Padding="4" ToolTip.Tip="{l:T Tahrirlash}" HorizontalAlignment="Center"
                                                IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext).KoradiSotuvTahrirlash}"
                                                Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).SotuvTahrir.OchCommand}" CommandParameter="{Binding}">
                                            <ctl:Ikon Nomi="edit" Olcham="15" />
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
