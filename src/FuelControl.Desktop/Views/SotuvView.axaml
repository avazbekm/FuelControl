<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:FuelControl.Desktop.Controls"
             xmlns:vm="using:FuelControl.Desktop.ViewModels"
             xmlns:m="using:FuelControl.Desktop.Models"
             xmlns:ctl="using:FuelControl.Desktop.Controls"
             x:Class="FuelControl.Desktop.Views.SotuvView"
             x:DataType="vm:SotuvViewModel">

    <Grid ColumnDefinitions="*,380" Margin="28,16,28,16" ColumnSpacing="18">

        <!-- ============ Chap: 4 qadam ============ -->
        <ScrollViewer Grid.Column="0">
            <StackPanel Spacing="10">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="3">
                        <TextBlock Text="{l:T SotuvKiritish}" Classes="sarlavha" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border Classes="badge yashil" IsVisible="{Binding SmenaOchiq}"><TextBlock Text="{l:T SmenaOchiq, Oldi=● }" /></Border>
                            <Border Classes="badge kulrang" IsVisible="{Binding !SmenaOchiq}"><TextBlock Text="{l:T SmenaYopiq}" /></Border>
                            <TextBlock Text="{Binding SmenaMatni}" Classes="izoh" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Classes="success" IsVisible="{Binding SmenaOchishKorinsin}"
                                Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).Smenalar.SmenaOchCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8"><ctl:Ikon Nomi="play" Olcham="16" Rang="White" /><TextBlock Text="{l:T SmenaOchish}" /></StackPanel>
                        </Button>
                        <Button Classes="ghost" IsVisible="{Binding SmenaYopishKorinsin}"
                                Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).Smenalar.JoriySmenaniYopCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8"><ctl:Ikon Nomi="stop" Olcham="16" /><TextBlock Text="{l:T SmenaniYopish}" /></StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- 1-qadam: aparat -->
                <Border Classes="card" Padding="20,16">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border Classes="orb" Width="28" Height="28">
                                <TextBlock Text="1" Foreground="White" FontWeight="ExtraBold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="{l:T AparatniTanlang}" Classes="kichikSarlavha" VerticalAlignment="Center" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding Aparatlar}" ClipToBounds="False" Margin="0,0,0,6">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel ItemSpacing="12" LineSpacing="12" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:AparatElementi">
                                    <Button Classes="aparat" Classes.tanlangan="{Binding Tanlangan}"
                                            Command="{Binding $parent[UserControl].((vm:SotuvViewModel)DataContext).AparatniTanlaCommand}"
                                            CommandParameter="{Binding}">
                                        <StackPanel Spacing="3" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding Nomi}" FontWeight="ExtraBold" FontSize="16" HorizontalAlignment="Center" />
                                            <Border CornerRadius="999" Padding="12,3" Background="{Binding Rang}" HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding Yoqilgi}" Foreground="White" FontSize="13" FontWeight="Bold" />
                                            </Border>
                                            <TextBlock Text="{Binding Narx}" Classes="izoh" HorizontalAlignment="Center" />
                                            <Border Classes="chiziq" Margin="12,2,12,0" />
                                            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                                <TextBlock Text="L" Classes="izoh" FontWeight="Bold" />
                                                <TextBlock Text="{Binding TotalLitr}" FontSize="13" FontWeight="ExtraBold" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- 2-qadam: summa yoki litr -->
                <Border Classes="card" Padding="20,16">
                    <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Border Classes="orb" Width="28" Height="28">
                                    <TextBlock Text="2" Foreground="White" FontWeight="ExtraBold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="{l:T SummaYokiLitr}" Classes="kichikSarlavha" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                <Button Classes="chip" Classes.tanlangan="{Binding SummaRejimi}" Content="{l:T Som}" Command="{Binding RejimniTanlaCommand}" CommandParameter="summa" />
                                <Button Classes="chip" Classes.tanlangan="{Binding !SummaRejimi}" Content="{l:T Litr}" Command="{Binding RejimniTanlaCommand}" CommandParameter="litr" />
                            </StackPanel>
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                            <StackPanel Spacing="8">
                                <TextBox Classes="katta" Text="{Binding Kiritilgan}" PlaceholderText="0" />
                                <TextBlock Text="{Binding HisobIzohi}" Classes="izoh" HorizontalAlignment="Right" IsVisible="{Binding AparatTanlangan}" />
                                <TextBlock Text="{l:T AvvalAparat}" Classes="izoh" Foreground="{DynamicResource Sariq}" HorizontalAlignment="Right" IsVisible="{Binding !AparatTanlangan}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="8" IsVisible="{Binding SummaRejimi}">
                                <TextBlock Text="{l:T TezKiritish, Katta=True}" Classes="yorliq" />
                                <UniformGrid Columns="3" ColumnSpacing="6" RowSpacing="6">
                                    <Button Classes="ghost" Content="+50 000" Command="{Binding TezCommand}" CommandParameter="50000" />
                                    <Button Classes="ghost" Content="+100 000" Command="{Binding TezCommand}" CommandParameter="100000" />
                                    <Button Classes="ghost" Content="+200 000" Command="{Binding TezCommand}" CommandParameter="200000" />
                                    <Button Classes="ghost" Content="+300 000" Command="{Binding TezCommand}" CommandParameter="300000" />
                                    <Button Classes="ghost" Content="+500 000" Command="{Binding TezCommand}" CommandParameter="500000" />
                                    <Button Classes="danger" Content="{l:T Tozalash}" Command="{Binding TozalashCommand}" />
                                </UniformGrid>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 3-qadam: to'lov -->
                <Border Classes="card" Padding="20,16">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border Classes="orb" Width="28" Height="28">
                                <TextBlock Text="3" Foreground="White" FontWeight="ExtraBold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="{l:T TolovTuri}" Classes="kichikSarlavha" VerticalAlignment="Center" />
                        </StackPanel>
                        <UniformGrid Columns="4" ColumnSpacing="10">
                            <Button Classes="tolov" Classes.tanlangan="{Binding TolovNaqd}" Command="{Binding TolovniTanlaCommand}" CommandParameter="0"><StackPanel Orientation="Horizontal" Spacing="8"><ctl:Ikon Nomi="cash" Olcham="18" /><TextBlock Text="{l:T Naqd}" /></StackPanel></Button>
                            <Button Classes="tolov" Classes.tanlangan="{Binding TolovPlastik}" Command="{Binding TolovniTanlaCommand}" CommandParameter="1"><StackPanel Orientation="Horizontal" Spacing="8"><ctl:Ikon Nomi="card" Olcham="18" /><TextBlock Text="{l:T Plastik}" /></StackPanel></Button>
                            <Button Classes="tolov" Classes.tanlangan="{Binding TolovClick}" Command="{Binding TolovniTanlaCommand}" CommandParameter="2"><StackPanel Orientation="Horizontal" Spacing="8"><ctl:Ikon Nomi="phone" Olcham="18" /><TextBlock Text="{l:T Click}" /></StackPanel></Button>
                            <Button Classes="tolov" Classes.tanlangan="{Binding TolovAralash}" Command="{Binding TolovniTanlaCommand}" CommandParameter="3"><StackPanel Orientation="Horizontal" Spacing="8"><ctl:Ikon Nomi="mix" Olcham="18" /><TextBlock Text="{l:T Aralash}" /></StackPanel></Button>
                        </UniformGrid>

                        <Border Classes="tile" IsVisible="{Binding AralashKorinsin}" Padding="14,10">
                            <StackPanel Spacing="6">
                                <TextBlock Text="{l:T AralashIzoh}" Classes="izoh" />
                                <UniformGrid Columns="3" ColumnSpacing="10">
                                    <StackPanel>
                                        <TextBlock Text="{l:T Naqd, Katta=True}" Classes="yorliq" />
                                        <TextBox Text="{Binding AralashNaqd}" PlaceholderText="0" TextAlignment="Right" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="{l:T Plastik, Katta=True}" Classes="yorliq" />
                                        <TextBox Text="{Binding AralashPlastik}" PlaceholderText="0" TextAlignment="Right" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="{l:T Click, Katta=True}" Classes="yorliq" />
                                        <TextBox Text="{Binding AralashClick}" PlaceholderText="0" TextAlignment="Right" />
                                    </StackPanel>
                                </UniformGrid>
                                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                                    <TextBlock Text="{l:T Qoldiq, Keyin=:}" Classes="izoh" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding AralashQoldiq}" FontWeight="Bold"
                                               Classes.musbat="{Binding AralashTogri}" Classes.manfiy="{Binding !AralashTogri}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ============ O'ng: xulosa + saqlash + bugungi ro'yxat ============ -->
        <Grid Grid.Column="1" RowDefinitions="Auto,*" RowSpacing="16">
            <Border Grid.Row="0" Classes="deep">
                <StackPanel Spacing="14">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border Width="28" Height="28" CornerRadius="14" Background="#40FFFFFF" BoxShadow="0 0 0 0 #00000000">
                            <TextBlock Text="4" Foreground="White" FontWeight="ExtraBold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="{l:T TekshiribSaqlang}" FontSize="15" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
                    </StackPanel>

                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                        <TextBlock Grid.Row="0" Text="{l:T Yoqilgi}" Foreground="#BFFFFFFF" FontSize="13" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding YoqilgiNomi}" Foreground="White" FontWeight="Bold" />
                        <TextBlock Grid.Row="1" Text="{l:T Narx}" Foreground="#BFFFFFFF" FontSize="13" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding NarxMatni}" Foreground="White" FontWeight="Bold" />
                        <TextBlock Grid.Row="2" Text="{l:T Litr}" Foreground="#BFFFFFFF" FontSize="13" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding LitrMatni}" Foreground="White" FontWeight="Bold" />
                    </Grid>

                    <Border Height="1" Background="#40FFFFFF" />
                    <StackPanel Spacing="2">
                        <TextBlock Text="{l:T JamiSumma, Katta=True}" Foreground="#BFFFFFFF" FontSize="11" FontWeight="Bold" LetterSpacing="1" />
                        <TextBlock Text="{Binding SummaMatni}" Foreground="White" FontSize="34" FontWeight="ExtraBold" LetterSpacing="-1" />
                    </StackPanel>

                    <Button Classes="success" Height="54" FontSize="16" HorizontalAlignment="Stretch" Command="{Binding SaqlashCommand}"><StackPanel Orientation="Horizontal" Spacing="8"><ctl:Ikon Nomi="check" Olcham="18" Rang="White" /><TextBlock Text="{l:T Saqlash}" /></StackPanel></Button>
                    <TextBlock Text="{Binding Xabar}" Foreground="#E6FFFFFF" FontSize="12" TextWrapping="Wrap"
                               IsVisible="{Binding Xabar, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Classes="card" Padding="20,18,20,8">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10" LastChildFill="True">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding JamiBugun}" Classes="pul" TextAlignment="Right" VerticalAlignment="Center" MinWidth="110" Margin="8,0,0,0" />
                        <TextBlock Text="{l:T BugungiSotuvlarim}" Classes="kichikSarlavha" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding BugungiSotuvlar}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="m:Sotuv">
                                    <Border BorderBrush="{DynamicResource Chiziq}" BorderThickness="0,0,0,1" Padding="0,9">
                                        <Grid ColumnDefinitions="48,*,Auto,Auto">
                                            <TextBlock Text="{Binding Vaqt, StringFormat='HH:mm'}" Classes="izoh" VerticalAlignment="Center" />
                                            <Button Grid.Column="3" Classes="ikon" Margin="4,0,0,0" ToolTip.Tip="{l:T Tahrirlash}"
                                                    IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext).KoradiSotuvTahrirlash}"
                                                    Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).SotuvTahrir.OchCommand}" CommandParameter="{Binding}">
                                                <ctl:Ikon Nomi="edit" Olcham="15" />
                                            </Button>
                                            <StackPanel Grid.Column="1" Spacing="2">
                                                <TextBlock FontSize="13">
                                                    <Run Text="{l:T Aparat}" /><Run Text=" " /><Run Text="{Binding Aparat.Raqam}" /><Run Text=" · " /><Run Text="{Binding YoqilgiNomi}" FontWeight="SemiBold" />
                                                </TextBlock>
                                                <TextBlock Classes="izoh"><Run Text="{Binding Litr, StringFormat='0.00'}" /><Run Text=" l · " /><Run Text="{Binding TolovNomi}" /></TextBlock>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding Summa, StringFormat='#,0'}" Classes="pul" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
